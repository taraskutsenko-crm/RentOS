# Node
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=rentos
POSTGRES_PASSWORD=rentos
POSTGRES_DB=rentos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rentos:rentos@localhost:5432/rentos?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
PORT=4000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth
# Origin allowed to call the API with credentials (CORS). Must match the
# web app's origin exactly.
WEB_ORIGIN=http://localhost:3000
# Secret used to sign short-lived JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Never reuse this value across environments.
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# Separate secret for customer-portal sessions (TASK-0009) — never reuse
# JWT_ACCESS_SECRET here; the two token types must stay cryptographically
# unrelated. Generate the same way as JWT_ACCESS_SECRET above.
JWT_CUSTOMER_ACCESS_SECRET=dev-only-change-me-portal-dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Leave unset for localhost development. In production, set to the parent
# domain shared by the web and api subdomains (e.g. ".rentos.com") so the
# auth cookies are sent to both.
# COOKIE_DOMAIN=

# File storage (asset images/documents, generated PDFs, Handover/Return
# attachments). See docs/adr/0005-asset-file-storage-strategy.md and
# docs/adr/0013-production-storage-and-email.md.
# STORAGE_DRIVER=local (default) uses the filesystem below; STORAGE_DRIVER=s3
# switches to S3StorageAdapter — works with AWS S3, Cloudflare R2, Backblaze
# B2, MinIO, or any other S3-compatible provider.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-uploads
# Only read when STORAGE_DRIVER=s3 — omit S3_ENDPOINT entirely for real AWS
# S3; set it to your provider's endpoint for R2/B2/MinIO/etc.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=havelio-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=

# Outbound email (document/quote/invoice sending). See
# docs/adr/0013-production-storage-and-email.md.
# EMAIL_DRIVER=logging (default) never actually sends — it only logs what
# would have been sent, and every "sent" status is honestly reported as
# NOT_CONFIGURED. EMAIL_DRIVER=smtp switches to a real transactional-SMTP
# transport (Amazon SES SMTP, SendGrid SMTP, Mailgun SMTP, Postmark SMTP, or
# any other SMTP provider).
EMAIL_DRIVER=logging
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Havelio
# SMTP_REPLY_TO=

# Encrypts country-specific e-invoice provider credentials at rest (e.g. a
# Poland KSeF token — see EInvoiceConnection.encryptedCredentials and
# EncryptionService). AES-256-GCM key, exactly 64 hex characters (32 bytes).
# Required at boot — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KSEF_ENCRYPTION_KEY=
