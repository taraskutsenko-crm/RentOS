# Used by the test suite (pnpm test). Points at a dedicated test database —
# never the dev or production one. Contains no real secrets.
NODE_ENV=test
PORT=4000
DATABASE_URL=postgresql://rentos:rentos@localhost:5432/rentos_test?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=test-only-secret-test-only-secret-test-only
JWT_CUSTOMER_ACCESS_SECRET=test-only-customer-secret-test-only-customer
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_LOCAL_DIR=./storage-uploads-test
KSEF_ENCRYPTION_KEY=467bc28bf643d5e05d8f7bb4b03b2e531be5659d65c009d64b7ef188828393e4
# Havelio Billing (Stage 17) — fake, non-functional Stripe test-mode-shaped
# values so StripeProvider.isConfigured()=true and webhook signature
# verification (a purely local crypto operation, no network call) can be
# unit-tested — see stripe-webhooks.controller.e2e-spec.ts. Any test that
# would make a real Stripe API call (checkout, portal, subscription
# retrieval) is expected to fail against these and is never exercised in
# this suite — see docs/DECISIONS.md "REAL STRIPE CONNECTION: NOT CONFIGURED".
STRIPE_SECRET_KEY=sk_test_fake_key_for_local_signature_tests_only
STRIPE_WEBHOOK_SECRET=whsec_fake_secret_for_local_signature_tests_only
