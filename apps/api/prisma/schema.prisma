generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  TECHNICIAN
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum AssetFieldType {
  TEXT
  TEXTAREA
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTISELECT
  URL
  EMAIL
  PHONE
}

enum AssetDocumentType {
  PURCHASE_DOCUMENT
  MANUAL
  CERTIFICATE
  INSURANCE
  REGISTRATION
  INSPECTION
  OTHER
}

/// A reason an asset is blocked out of availability for a date range, distinct
/// from a Rental's own RESERVED/ACTIVE claim (see AssetAvailabilityBlock).
/// INSPECTION/RELOCATION are included because they can legitimately take an
/// asset out of service for a period even though they aren't a rental — same
/// "three-industry test" as every other asset concept (PRODUCT_BIBLE §3):
/// maintenance/repair/inspection/relocation/manual-block apply equally to a
/// vehicle, a generator, or a folding table.
enum AssetAvailabilityBlockType {
  MAINTENANCE
  REPAIR
  INSPECTION
  RELOCATION
  MANUAL_BLOCK
}

/// Rental lifecycle: DRAFT -> QUOTE -> RESERVED -> ACTIVE -> RETURNED -> COMPLETED,
/// with CANCELLED reachable from every non-terminal state. See
/// docs/adr/0006-rental-lifecycle-and-availability.md.
enum RentalStatus {
  DRAFT
  QUOTE
  RESERVED
  ACTIVE
  RETURNED
  COMPLETED
  CANCELLED
}

/// How a RentalItem's line price is computed. CUSTOM uses customPriceMinor
/// as a flat total, ignoring duration entirely (e.g. a negotiated package price).
enum RentalBillingMode {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

/// How a tenant defines "one month" for MONTHLY-billed rental items. See
/// docs/adr/0008-configurable-monthly-billing-strategies.md.
///  - CALENDAR_MONTH: real calendar-month arithmetic (default for every
///    tenant, including ones that existed before this enum was added).
///  - FIXED_30_DAYS: every 30 billable days is one monthly unit.
///  - CUSTOM: every `RentalBillingSettings.customMonthLengthDays` billable
///    days is one monthly unit.
/// In every strategy, days left over after the last complete unit are
/// billed at the item's own dailyPriceMinor rate (see rental-pricing.util.ts).
enum MonthlyBillingStrategy {
  CALENDAR_MONTH
  FIXED_30_DAYS
  CUSTOM
}

/// How a MONTHLY item's leftover partial period (after MonthlyBillingStrategy
/// splits the range into complete units + remaining days) is actually
/// charged. See DECISIONS.md D-072.
///  - PRORATE_BY_DAY: the remaining days are billed at the item's own
///    dailyPriceMinor rate — the original, still-default behavior.
///  - ROUND_UP_TO_FULL_MONTH: any started remaining period is billed as one
///    more full monthlyPriceMinor unit; dailyPriceMinor is not required.
/// A null value on RentalItem/QuoteItem (pre-existing rows written before
/// this policy existed) behaves exactly like PRORATE_BY_DAY — the
/// calculation those rows were actually priced under — never silently
/// recalculated (mirrors the existing MonthlyBillingStrategy null-handling).
enum PartialMonthPolicy {
  PRORATE_BY_DAY
  ROUND_UP_TO_FULL_MONTH
}

/// Quote lifecycle: DRAFT -> SENT -> VIEWED -> ACCEPTED -> CONVERTED, with
/// REJECTED/EXPIRED reachable from SENT/VIEWED and CANCELLED reachable from
/// DRAFT/SENT. See docs/adr/0007-quotes-and-commercial-offers.md.
enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

/// What a QuoteItem represents. Deliberately generic — never a specific
/// rental industry's vocabulary. ASSET items may become RentalItem rows on
/// conversion; every other type is a commercial line that stays on the
/// Quote only (see ADR 0007).
enum QuoteItemType {
  ASSET
  SERVICE
  PRODUCT
  FEE
  DELIVERY
  COLLECTION
  LABOR
  CUSTOM
}

/// How a QuoteItem's line price is computed. A superset of RentalBillingMode
/// with FLAT added: unitPriceMinor * quantity, no duration factor — for
/// lines that aren't priced per day/week/month (a delivery fee, N hours of
/// labor, N units of a product). ASSET items should use DAILY/WEEKLY/
/// MONTHLY/CUSTOM only (enforced in QuotesService, not the database) since
/// those are the only modes RentalItem itself supports on conversion.
enum QuoteBillingMode {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
  FLAT
}

/// Whether a discount is a percentage (discountValue is interpreted as
/// integer basis points, e.g. 1000 = 10.00%) or a fixed amount (discountValue
/// is interpreted as integer minor currency units). Never floating point —
/// see ADR 0007's "decimal-safe arithmetic" section.
enum QuoteDiscountType {
  PERCENTAGE
  FIXED
}

/// The kind of business document a Document row represents. Deliberately a
/// fixed, small set — never an industry-specific vocabulary — mirroring
/// QuoteItemType's convention of a CUSTOM escape hatch for anything not
/// covered by a built-in type (see Document.customTypeName). QUOTE is
/// included here for taxonomic completeness and future unification only —
/// TASK-0008 Part 1 does not migrate the existing Quote module into Document
/// rows (see docs/adr/0010-document-management-platform.md).
enum DocumentType {
  QUOTE
  CONTRACT
  HANDOVER_PROTOCOL
  RETURN_PROTOCOL
  DAMAGE_REPORT
  CONTRACT_AMENDMENT
  /// A deposit-receipt/confirmation document ("Potwierdzenie przyjęcia
  /// kaucji") generated from a RentalDeposit's received state — same
  /// universal Document/DocumentType platform as every other document type,
  /// no type-specific columns (see ARCHITECTURE_LOCK §2).
  DEPOSIT_RECEIPT
  CUSTOM
}

/// Document lifecycle: DRAFT -> READY -> SENT -> VIEWED -> (PARTIALLY_SIGNED
/// ->) SIGNED, with REJECTED reachable from VIEWED and VOIDED reachable from
/// every non-terminal state; every terminal state (SIGNED/REJECTED/VOIDED)
/// can additionally move to ARCHIVED. See
/// docs/adr/0010-document-management-platform.md.
enum DocumentStatus {
  DRAFT
  READY
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  REJECTED
  VOIDED
  ARCHIVED
}

/// The rendering/storage format of one DocumentFile. PDF/HTML/JSON_SNAPSHOT
/// are system-generated renderings of a DocumentVersion's business data;
/// ATTACHMENT/PHOTO are staff-uploaded supporting files (e.g. a damage
/// photo); DOCX/XML are named now as documented future formats (no
/// generator exists yet) rather than requiring a schema change later.
enum DocumentFileFormat {
  PDF
  HTML
  JSON_SNAPSHOT
  DOCX
  XML
  ATTACHMENT
  PHOTO
}

/// A DocumentTemplate's lifecycle — see docs/adr/0011-document-rendering-and-sharing.md.
enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The e-signature provider a DocumentSignatureRequest was sent through.
/// LOCAL_MOCK is the only implementation shipped in TASK-0008 Part 2 (see
/// DocumentSignatureProvider); the rest are reserved values for future
/// providers, the same "name the enum value now, build the integration
/// later" convention already used for DocumentFileFormat.DOCX/XML.
enum DocumentSignatureProviderType {
  LOCAL_MOCK
  DOCUSIGN
  ADOBE_SIGN
  AUTENTI
  EIDAS
}

/// DocumentSignatureRequest lifecycle, matching the task's exact
/// requirement list: REQUESTED (just sent to the provider) -> PENDING
/// (provider acknowledged, awaiting the signer) -> SIGNED/REJECTED/EXPIRED,
/// with CANCELLED reachable from REQUESTED/PENDING.
enum DocumentSignatureStatus {
  REQUESTED
  PENDING
  SIGNED
  REJECTED
  EXPIRED
  CANCELLED
}

/// Groups a staff-uploaded DocumentFile (ATTACHMENT/PHOTO) by what it shows
/// — Handover/Return Protocol photo evidence today, kept generic (not
/// "VEHICLE_DAMAGE" or similar) so it stays meaningful for any asset
/// vertical. Null on every system-generated rendering (PDF/HTML/etc.) and
/// optional even for staff uploads — a category is a helpful filter, never
/// a required classification.
enum DocumentAttachmentCategory {
  HANDOVER_CONDITION
  RETURN_CONDITION
  DAMAGE
  OTHER
}

/// Havelio Signature System (visual handwritten signatures, NOT a
/// qualified electronic signature — see docs/PRODUCT_BIBLE.md). Who
/// supplied the visual signature captured for a specific document. Just
/// two roles: a tenant representative signs on behalf of the company; a
/// customer signs for themselves. A technician who hands their device to
/// a customer for an in-person signature still records signerType
/// CUSTOMER — see SignatureSource for who physically operated the device.
enum SignatureSignerType {
  TENANT_REPRESENTATIVE
  CUSTOMER
}

/// How the pixels of one signature image were produced. STORED_SIGNATURE
/// = reused the tenant's saved TenantSignature at the moment of signing
/// (its bytes are still copied into a fresh DocumentSignatureEvidence row
/// — never a live reference, see that model's own comment). DRAWN = drawn
/// live on a canvas (SignaturePad) for this specific signing. UPLOADED =
/// an image file uploaded for this specific signing.
enum SignatureCaptureMethod {
  STORED_SIGNATURE
  DRAWN
  UPLOADED
}

/// Where a signature was captured from — informational audit context
/// only, never itself a security boundary (the boundary is the
/// authenticated/tenant-scoped endpoint that wrote the row).
enum SignatureSource {
  COMPANY_PROFILE
  STAFF_DEVICE
  CUSTOMER_PORTAL
}

/// Who a DocumentEmailDelivery was addressed to.
enum DocumentEmailRecipientType {
  CUSTOMER
  EMPLOYEE
  CUSTOM
}

enum DocumentEmailStatus {
  PENDING
  SENT
  FAILED
  /// No real email transport is configured in this environment (see
  /// LoggingEmailProvider) — the message was never actually attempted, so
  /// the UI must never claim "Sent". See DECISIONS.md, email truthfulness fix.
  NOT_CONFIGURED
}

/// Coarse, safe-to-display reason a FAILED email delivery failed — never
/// derived from raw provider/SMTP response text (see SmtpEmailProvider's own
/// doc comment on never surfacing that verbatim). Set only when
/// status=FAILED; null for PENDING/SENT/NOT_CONFIGURED. See DECISIONS.md,
/// email-delivery diagnosis fix.
enum EmailErrorCategory {
  /// SMTP authentication rejected the configured credentials.
  AUTH_FAILED
  /// The provider rejected the From/sending domain as unverified.
  DOMAIN_NOT_VERIFIED
  /// The SMTP server rejected the message itself (e.g. after DATA).
  SMTP_REJECTED
  /// Could not establish or maintain a connection within a reasonable time.
  CONNECTION_TIMEOUT
  /// The recipient address was rejected by the provider.
  RECIPIENT_REJECTED
  /// The message's PDF/attachment could not be generated — the send was
  /// never attempted (see DocumentEmailService.dispatch's doc comment).
  ATTACHMENT_GENERATION_FAILED
  /// Any other provider-side failure not covered above.
  PROVIDER_ERROR
}

// ===========================================================================
// Invoicing, Bank Details & E-Invoice Architecture (PRE-CHAPTER-10 addition).
// Invoice is deliberately a standalone business model, NOT a Document row —
// it has its own numbering scheme, its own line-item/tax shape, its own
// payment-tracking relations, and its own KSeF/e-invoice fields, none of
// which fit the generic Document platform's businessDataSnapshot without
// widening DocumentType and every exhaustive switch over it. Invoice PDF
// rendering reuses PdfRendererService.renderPdf(html) directly (the same
// Puppeteer engine Document uses) via a dedicated invoice-renderer, so no
// second PDF engine is introduced. See docs/DECISIONS.md.
// ===========================================================================

/// A tenant's bank account for receiving payment — structured, not a single
/// free-text field, so individual parts (IBAN, SWIFT/BIC, ...) can be
/// resolved as their own document variables and validated independently. A
/// tenant may have several (e.g. one per currency); `isDefault` marks the
/// one prefilled onto new invoices, enforced single-per-tenant in
/// CompanyBankAccountsService (mirrors AssetFilesService's isPrimary-image
/// pattern), never at the DB level, since "no default yet" is also valid.
model CompanyBankAccount {
  id               String    @id @default(uuid())
  tenantId         String
  /// Tenant-chosen label for this account (e.g. "PLN account", "EUR — main")
  /// — never a generated/internal identifier shown to users.
  label            String
  bankName         String?
  accountHolder    String?
  accountNumber    String?
  iban             String?
  swiftBic         String?
  currency         String    @db.VarChar(3)
  bankAddress      String?
  /// A fixed reference/note tenants ask customers to quote when paying
  /// (e.g. a company-wide reference code) — distinct from a per-invoice
  /// payment reference.
  paymentReference String?
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("company_bank_accounts")
}

/// STANDARD is a normal invoice; PROFORMA is a non-fiscal preview issued
/// before payment/delivery; CORRECTION is named now as a documented future
/// value (mirrors DocumentFileFormat.DOCX/XML's "reserve the enum value,
/// build the workflow later" convention) — a full correction/credit-note
/// workflow (see InvoiceStatus.CORRECTED) is explicitly out of scope for
/// this pass; today nothing ever creates a CORRECTION-typed Invoice.
enum InvoiceType {
  STANDARD
  PROFORMA
  CORRECTION
}

/// DRAFT (editable, prefilled from a Rental, not yet legally issued) ->
/// ISSUED (finalized, snapshots frozen) -> SENT (delivered to the
/// customer) -> PARTIALLY_PAID/PAID (derived from recorded Payments, see
/// PaymentsService) -> OVERDUE (derived: past dueDate, not fully paid) ->
/// CANCELLED (an issued invoice voided without payment) or CORRECTED
/// (superseded by a correction — see InvoiceType.CORRECTION; no code path
/// sets this yet, reserved for that future workflow).
enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  CORRECTED
}

/// Where a Payment came from. OTHER is the generic escape hatch, matching
/// every other tenant-facing enum's CUSTOM/OTHER convention in this schema.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

/// The e-invoice submission state for one Invoice, tracked entirely
/// separately from InvoiceStatus (see docs/DECISIONS.md) so a Havelio
/// invoice's own business lifecycle is never overloaded with a specific
/// country's compliance-system lifecycle. NOT_SENT is the default for
/// every tenant/country, including ones with no e-invoicing obligation at
/// all — nothing here assumes Poland/KSeF.
enum EInvoiceStatus {
  NOT_SENT
  PENDING
  ACCEPTED
  REJECTED
  ERROR
}

/// A country-specific e-invoicing system Havelio can integrate with. KSEF
/// is the only value today (Poland's Krajowy System e-Faktur); the type is
/// deliberately open-ended so a future country's system is a new enum
/// value and a new EInvoiceProvider implementation, never a change to the
/// core Invoice model (see docs/DECISIONS.md, "provider-neutral
/// architecture").
enum EInvoiceProviderType {
  KSEF
}

enum EInvoiceConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// A tenant's connection to one country-specific e-invoicing provider — the
/// Settings -> Integrations boundary (see docs/DECISIONS.md). Deliberately
/// holds no real KSeF endpoint calls; this pass ships the provider
/// boundary/settings architecture only (see EInvoiceProvider,
/// KsefProvider), never a faked "connected" state. `encryptedCredentials`
/// is AES-256-GCM ciphertext (ivBase64.authTagBase64.ciphertextBase64, see
/// EncryptionService) — the plaintext token/certificate is never persisted,
/// never logged, and never returned by any API response.
model EInvoiceConnection {
  id                   String                   @id @default(uuid())
  tenantId             String
  provider             EInvoiceProviderType
  status               EInvoiceConnectionStatus @default(NOT_CONNECTED)
  /// Provider-defined environment label (e.g. "test" | "production" for
  /// KSeF) — free text so a future provider's own environment vocabulary
  /// never requires a schema change.
  environment          String?
  encryptedCredentials String?
  lastError            String?
  connectedAt          DateTime?
  lastCheckedAt        DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("einvoice_connections")
}

/// A first-class business object — NOT a generic Document row (see the
/// section banner above). `sellerSnapshot`/`buyerSnapshot`/`bankSnapshot`
/// freeze the legally relevant Tenant/Customer/CompanyBankAccount data at
/// creation time, the same "capture now" pattern
/// DocumentVersion.businessDataSnapshot already uses — a later edit to the
/// Company Profile, the Customer record, or the bank account can never
/// retroactively change an already-issued invoice. `documentLanguage` is
/// resolved once via resolveDefaultDocumentLanguage (company-country-first,
/// same resolver Contract/Handover/Return use) at creation time and frozen
/// for the same reason. One Rental may have any number of Invoices —
/// `rentalId` is a plain nullable FK, never unique — supporting upfront,
/// after-return, per-period, deposit-separate, and services-separate
/// invoicing patterns (see docs/DECISIONS.md).
model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  invoiceNumber String
  type          InvoiceType   @default(STANDARD)
  status        InvoiceStatus @default(DRAFT)

  issueDate        DateTime
  /// Date goods/services were sold or delivered — distinct from issueDate
  /// in several jurisdictions (e.g. Poland's "Data sprzedaży"). Null when a
  /// tenant's locale draws no such distinction.
  saleDate         DateTime?
  dueDate          DateTime?
  /// When this invoice was marked SENT — kept as its own timestamp,
  /// separate from `status`, because `status` moves on to
  /// PARTIALLY_PAID/PAID/OVERDUE once payment begins, which would
  /// otherwise make "was this ever sent to the customer" unrecoverable
  /// without scanning InvoiceStatusHistory.
  sentAt           DateTime?
  currency         String    @db.VarChar(3)
  /// Frozen at creation time via resolveDefaultDocumentLanguage — see the
  /// model doc comment above.
  documentLanguage String    @db.VarChar(10)

  customerId    String
  rentalId      String?
  sourceQuoteId String?
  bankAccountId String?

  sellerSnapshot Json
  buyerSnapshot  Json
  bankSnapshot   Json?

  subtotalMinor Int @default(0)
  discountMinor Int @default(0)
  taxMinor      Int @default(0)
  totalMinor    Int @default(0)

  /// Informational only — the method the tenant expects/requests, never
  /// used to infer that payment has actually happened (see Payment below).
  preferredPaymentMethod PaymentMethod?
  /// Per-invoice reference the customer is asked to quote when paying —
  /// distinct from CompanyBankAccount.paymentReference (that one is
  /// account-wide).
  paymentReference       String?
  notes                  String?

  eInvoiceStatus          EInvoiceStatus @default(NOT_SENT)
  eInvoiceReferenceNumber String?
  eInvoiceSubmittedAt     DateTime?
  eInvoiceProcessedAt     DateTime?
  eInvoiceError           String?

  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer            @relation(fields: [customerId], references: [id])
  rental        Rental?             @relation(fields: [rentalId], references: [id])
  sourceQuote   Quote?              @relation(fields: [sourceQuoteId], references: [id])
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id])
  createdByUser User                @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?               @relation("InvoiceUpdatedBy", fields: [updatedByUserId], references: [id])

  items           InvoiceItem[]
  payments        Payment[]
  statusHistory   InvoiceStatusHistory[]
  emailDeliveries InvoiceEmailDelivery[]
  paymentDemands  PaymentDemand[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, rentalId])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDate])
  /// Backs Financial Reports & Analytics V1's period-scoped "invoiced in
  /// range" queries (FinanceReportsService), which always filter on
  /// (tenantId, issueDate) — see docs/DECISIONS.md.
  @@index([tenantId, issueDate])
  @@index([tenantId, deletedAt])
  @@map("invoices")
}

/// One line on an Invoice — description/quantity/unit/unitNetPrice/discount/
/// taxRate with net/tax/gross totals computed via invoice-pricing.util.ts
/// (which reuses resolveDiscountMinor/resolveTaxMinor from
/// quote-pricing.util.ts rather than reinventing the arithmetic). Generic
/// enough for a rented asset, delivery, pickup, installation, cleaning,
/// fuel, transport, a damage charge, a late fee, or any other goods/service
/// — never limited to asset lines.
model InvoiceItem {
  id          String  @id @default(uuid())
  tenantId    String
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unit        String?

  unitNetPriceMinor Int @default(0)
  discountMinor     Int @default(0)
  /// Integer basis points (2300 = 23.00%), matching QuoteItem.taxRateBp —
  /// never a float rate.
  taxRateBp         Int @default(0)
  netTotalMinor     Int @default(0)
  taxTotalMinor     Int @default(0)
  grossTotalMinor   Int @default(0)
  sortOrder         Int @default(0)

  /// Optional traceability back to the RentalItem a "create from Rental"
  /// prefill copied this line from — null for delivery/damage/late-fee/
  /// ad-hoc lines that never had a RentalItem.
  sourceRentalItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceRentalItem RentalItem? @relation(fields: [sourceRentalItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, sourceRentalItemId])
  @@map("invoice_items")
}

/// Backs concurrency-safe invoice-number generation — one counter row per
/// (tenantId, year, month), mirroring QuoteSequence's proven
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` pattern (see
/// invoice-numbering.util.ts). Month-scoped (not just year, unlike
/// QuoteSequence) so the default format can naturally reset monthly (e.g.
/// "INV-2026-08-000001") the way many jurisdictions' invoice numbering
/// conventions expect — this is a DEFAULT format only, not hard-coded
/// Polish numbering: a tenant-configurable numbering format is documented
/// future work (see docs/DECISIONS.md).
model InvoiceSequence {
  id         String @id @default(uuid())
  tenantId   String
  year       Int
  month      Int
  lastNumber Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@map("invoice_sequences")
}

/// One recorded payment against an Invoice — the minimal payment-tracking
/// domain (see docs/DECISIONS.md). Deliberately an explicit, staff-recorded
/// action; Invoice.status is never inferred merely because an Invoice was
/// created (see PaymentsService, which derives PARTIALLY_PAID/PAID by
/// summing an invoice's non-voided Payment rows). Append-only — a mistaken
/// payment is never edited or hard-deleted through normal use; it is either
/// corrected with an equal-and-opposite negative-amount entry (the
/// original, still-supported convention) or explicitly voided (`voidedAt`/
/// `voidedByUserId`/`voidReason`, see docs/DECISIONS.md D-12x) — a voided
/// row is excluded from every paid-total calculation but is never deleted,
/// preserving a full, honest audit trail.
model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  invoiceId   String
  amountMinor Int
  currency    String        @db.VarChar(3)
  paymentDate DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?

  /// Set when this payment was funded by reallocating an already-held
  /// RentalDeposit rather than new incoming money — see
  /// RentalDeposit/PaymentsService.applyDeposit and docs/DECISIONS.md.
  /// Never changes which Invoice this Payment counts against; it is
  /// provenance only, so the invoice's derived paid/remaining totals stay
  /// a single, simple sum regardless of a payment's source.
  sourceRentalDepositId String?

  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?

  createdByUserId String
  createdAt       DateTime @default(now())

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice             Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUser       User           @relation("PaymentRecordedBy", fields: [createdByUserId], references: [id])
  voidedByUser        User?          @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id])
  sourceRentalDeposit RentalDeposit? @relation(fields: [sourceRentalDepositId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, sourceRentalDepositId])
  /// Backs Financial Reports & Analytics V1's period-scoped "cash received
  /// in range" queries (FinanceReportsService), which always filter on
  /// (tenantId, paymentDate) — see docs/DECISIONS.md.
  @@index([tenantId, paymentDate])
  @@map("payments")
}

/// Append-only history of Invoice.status transitions, written atomically
/// with the status change itself — mirrors RentalStatusHistory/
/// QuoteStatusHistory exactly. changedByUserId is nullable because some
/// transitions are system-derived from Payment totals or the current date
/// (PARTIALLY_PAID/PAID/OVERDUE), not a direct staff action, the same
/// reason QuoteStatusHistory's changedByUserId is nullable for the public
/// accept/reject flow.
model InvoiceStatusHistory {
  id              String         @id @default(uuid())
  tenantId        String
  invoiceId       String
  fromStatus      InvoiceStatus?
  toStatus        InvoiceStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime       @default(now())

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedByUser User?   @relation("InvoiceStatusHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, invoiceId, createdAt])
  @@map("invoice_status_history")
}

/// Platform user identity. Not tenant-scoped — a user may belong to
/// multiple tenants via TenantMembership.
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  preferredLanguage String    @default("en") @db.VarChar(10)
  emailVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  /// Havelio PLATFORM administration (Stage 17) — grants access to
  /// cross-tenant platform-admin surfaces (all subscriptions, affiliate
  /// partners/campaigns/commissions, global revenue). Deliberately a
  /// distinct, explicit column checked by its own PlatformAdminGuard —
  /// never inferred from a `MembershipRole` (which is always scoped to one
  /// tenant) and never an email-address allowlist. Defaults false; only
  /// ever set by direct database/ops action or an already-platform-admin
  /// user, never self-service. See docs/DECISIONS.md.
  isPlatformAdmin   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAssets               Asset[]                  @relation("AssetCreatedBy")
  updatedAssets               Asset[]                  @relation("AssetUpdatedBy")
  assetStatusChanges          AssetStatusHistory[]     @relation("AssetStatusHistoryChangedBy")
  assetLocationChanges        AssetLocationHistory[]   @relation("AssetLocationHistoryChangedBy")
  uploadedAssetImages         AssetImage[]             @relation("AssetImageUploadedBy")
  uploadedAssetDocuments      AssetDocument[]          @relation("AssetDocumentUploadedBy")
  createdAvailabilityBlocks   AssetAvailabilityBlock[] @relation("AssetAvailabilityBlockCreatedBy")
  cancelledAvailabilityBlocks AssetAvailabilityBlock[] @relation("AssetAvailabilityBlockCancelledBy")
  createdRentalDeposits       RentalDeposit[]          @relation("RentalDepositCreatedBy")
  updatedRentalDeposits       RentalDeposit[]          @relation("RentalDepositUpdatedBy")

  createdRentals      Rental[]              @relation("RentalCreatedBy")
  updatedRentals      Rental[]              @relation("RentalUpdatedBy")
  rentalStatusChanges RentalStatusHistory[] @relation("RentalStatusHistoryChangedBy")

  createdQuotes            Quote[]              @relation("QuoteCreatedBy")
  updatedQuotes            Quote[]              @relation("QuoteUpdatedBy")
  quoteStatusChanges       QuoteStatusHistory[] @relation("QuoteStatusHistoryChangedBy")
  generatedQuoteDocuments  QuoteDocument[]      @relation("QuoteDocumentGeneratedBy")
  sentQuoteEmailDeliveries QuoteEmailDelivery[] @relation("QuoteEmailDeliverySentBy")

  createdDocuments                Document[]                 @relation("DocumentCreatedBy")
  updatedDocuments                Document[]                 @relation("DocumentUpdatedBy")
  employeeOnDocuments             Document[]                 @relation("DocumentEmployee")
  createdDocumentVersions         DocumentVersion[]          @relation("DocumentVersionCreatedBy")
  uploadedDocumentFiles           DocumentFile[]             @relation("DocumentFileUploadedBy")
  documentStatusChanges           DocumentStatusHistory[]    @relation("DocumentStatusHistoryChangedBy")
  createdDocumentTemplates        DocumentTemplate[]         @relation("DocumentTemplateCreatedBy")
  createdDocumentTemplateVersions DocumentTemplateVersion[]  @relation("DocumentTemplateVersionCreatedBy")
  createdDocumentShareLinks       DocumentShareLink[]        @relation("DocumentShareLinkCreatedBy")
  sentDocumentEmailDeliveries     DocumentEmailDelivery[]    @relation("DocumentEmailDeliverySentBy")
  requestedDocumentSignatures     DocumentSignatureRequest[] @relation("DocumentSignatureRequestedBy")

  sentPortalMessages         CustomerPortalMessage[]  @relation("CustomerPortalMessageSentBy")
  respondedExtensionRequests RentalExtensionRequest[] @relation("RentalExtensionRequestRespondedBy")
  reviewedDamageReports      RentalDamageReport[]     @relation("RentalDamageReportReviewedBy")

  createdInvoices            Invoice[]                    @relation("InvoiceCreatedBy")
  updatedInvoices            Invoice[]                    @relation("InvoiceUpdatedBy")
  invoiceStatusChanges       InvoiceStatusHistory[]       @relation("InvoiceStatusHistoryChangedBy")
  recordedPayments           Payment[]                    @relation("PaymentRecordedBy")
  voidedPayments             Payment[]                    @relation("PaymentVoidedBy")
  sentInvoiceEmailDeliveries InvoiceEmailDelivery[]       @relation("InvoiceEmailDeliverySentBy")
  createdPaymentDemands      PaymentDemand[]              @relation("PaymentDemandCreatedBy")
  sentPaymentDemandEmails    PaymentDemandEmailDelivery[] @relation("PaymentDemandEmailDeliverySentBy")

  createdAffiliatePartners AffiliatePartner[]      @relation("AffiliatePartnerCreatedBy")
  adminAttributions        AffiliateAttribution[]  @relation("AffiliateAttributionCreatedBy")
  recordedAffiliatePayouts AffiliatePayout[]       @relation("AffiliatePayoutRecordedBy")
  legalAcceptanceRecords   LegalAcceptanceRecord[] @relation("LegalAcceptanceAcceptedBy")

  @@index([deletedAt])
  @@map("users")
}

/// Multi-tenancy foundation: the tenant/organization boundary every future
/// business entity will reference for isolation. Not a business module.
model Tenant {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  countryCode          String    @db.VarChar(2)
  defaultLanguage      String    @default("en") @db.VarChar(10)
  defaultCurrency      String    @db.VarChar(3)
  timezone             String
  /// Legal-identity fields for rendering into commercial documents (the
  /// Contract "Parties" section, etc.) — all optional/nullable since a
  /// tenant may not have filled them in yet; VariableResolverService
  /// renders "" when null, exactly like every other optional variable.
  /// Edited via the Company Profile settings page (PATCH /tenants/:id).
  registrationNumber   String?
  taxNumber            String?
  address              String?
  phone                String?
  /// The tenant's customer-facing company email — canonical source for the
  /// Reply-To address on outbound transactional email (Quote/Document/
  /// Invoice/Handover/Return/portal-invite sends). Deliberately separate
  /// from any User.email (a staff login, not a company identity) and from
  /// SMTP_REPLY_TO (a single global env fallback, never tenant-specific).
  /// See tenant-sender-identity.util.ts / docs/adr/0013-production-storage-and-email.md.
  email                String?
  /// Havelio Company Branding (docs/PRODUCT_BIBLE.md) — the tenant's own
  /// logo, shown on its generated customer-facing documents instead of a
  /// generic Havelio placeholder. `logoStorageKey` is a private,
  /// server-generated StorageService key (never a public R2 URL, never
  /// exposed to the client) — see CompanyLogoService. All fields are
  /// nullable together (no logo uploaded yet is the default, valid state)
  /// and are set/cleared as one unit by that service, never edited
  /// directly via UpdateTenantDto. Replacing or removing the logo only
  /// ever updates these pointer fields — the underlying storage object at
  /// the old key is never deleted, so any document that already embedded
  /// those exact bytes (a finalized Document PDF, or an Invoice/Quote
  /// sellerSnapshot's captured logo) is never retroactively affected.
  logoStorageKey       String?
  logoMimeType         String?
  logoOriginalFileName String?
  logoWidth            Int?
  logoHeight           Int?
  logoSizeBytes        Int?
  logoChecksumSha256   String?
  logoUploadedAt       DateTime?
  logoUploadedByUserId String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  customers     Customer[]

  assetCategories             AssetCategory[]
  assets                      Asset[]
  assetStatusDefinitions      AssetStatusDefinition[]
  assetStatusHistory          AssetStatusHistory[]
  assetLocationHistory        AssetLocationHistory[]
  assetCustomFieldDefinitions AssetCustomFieldDefinition[]
  assetCustomFieldValues      AssetCustomFieldValue[]
  assetImages                 AssetImage[]
  assetDocuments              AssetDocument[]
  assetAvailabilityBlocks     AssetAvailabilityBlock[]

  rentals               Rental[]
  rentalItems           RentalItem[]
  rentalStatusHistory   RentalStatusHistory[]
  rentalBillingSettings RentalBillingSettings?
  rentalSequence        RentalSequence?
  rentalDeposits        RentalDeposit[]

  quotes             Quote[]
  quoteItems         QuoteItem[]
  quoteStatusHistory QuoteStatusHistory[]
  quoteDocuments     QuoteDocument[]
  quoteSequences     QuoteSequence[]

  documents                 Document[]
  documentVersions          DocumentVersion[]
  documentFiles             DocumentFile[]
  documentTemplates         DocumentTemplate[]
  documentTemplateVersions  DocumentTemplateVersion[]
  documentStatusHistory     DocumentStatusHistory[]
  documentItems             DocumentItem[]
  documentSequences         DocumentSequence[]
  documentShareLinks        DocumentShareLink[]
  documentEmailDeliveries   DocumentEmailDelivery[]
  documentSignatureRequests DocumentSignatureRequest[]
  tenantSignatures          TenantSignature[]
  documentSignatureEvidence DocumentSignatureEvidence[]
  quoteEmailDeliveries      QuoteEmailDelivery[]
  invoiceEmailDeliveries    InvoiceEmailDelivery[]

  customerPortalRefreshTokens CustomerRefreshToken[]
  customerPortalMessages      CustomerPortalMessage[]
  customerNotifications       CustomerNotification[]
  rentalExtensionRequests     RentalExtensionRequest[]
  rentalDamageReports         RentalDamageReport[]
  rentalDamageReportPhotos    RentalDamageReportPhoto[]

  companyBankAccounts          CompanyBankAccount[]
  invoices                     Invoice[]
  invoiceItems                 InvoiceItem[]
  invoiceSequences             InvoiceSequence[]
  payments                     Payment[]
  invoiceStatusHistory         InvoiceStatusHistory[]
  eInvoiceConnections          EInvoiceConnection[]
  paymentDemands               PaymentDemand[]
  paymentDemandSequences       PaymentDemandSequence[]
  paymentDemandEmailDeliveries PaymentDemandEmailDelivery[]

  /// Havelio Billing (Stage 17) — money Havelio itself receives from this
  /// tenant for using the product. Deliberately a completely separate
  /// domain from Invoice/Payment above (RENTAL FINANCE: money the tenant's
  /// own rental customers pay the tenant) — never the same tables, never
  /// combined in a report. See HavelioSubscription's own doc comment.
  havelioSubscription    HavelioSubscription?
  affiliateAttribution   AffiliateAttribution?
  affiliateCommissions   AffiliateCommissionEntry[]
  legalAcceptanceRecords LegalAcceptanceRecord[]

  @@index([deletedAt])
  @@map("tenants")
}

/// A user's membership within a tenant — carries their role and status.
/// The (tenantId, userId) pair is unique: a user has at most one
/// membership per tenant.
model TenantMembership {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

/// Rotating refresh tokens. Only a SHA-256 hash of the token is stored —
/// never the plain-text value. tenantId records the tenant that was
/// active when the token was issued; it is informational only and is
/// never trusted for authorization (see TenantGuard).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tenantId  String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only audit trail for security-relevant events. Never
/// cascade-deleted so history survives entity deletion.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// A tenant's customer record. Fully tenant-scoped — every query and
/// mutation is filtered by tenantId at the database level, never trusted
/// from a route param alone (see CustomersService).
model Customer {
  id        String         @id @default(uuid())
  tenantId  String
  firstName String
  lastName  String
  company   String?
  phone     String?
  email     String?
  vatNumber String?
  address   String?
  notes     String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  /// Customer Portal (TASK-0009) — self-service auth, entirely separate
  /// from User/TenantMembership. A Customer has no login by default;
  /// staff must explicitly invite them (see docs/adr/0012-customer-portal.md).
  /// Only the SHA-256 hash of the invitation token is ever persisted, same
  /// convention as every other opaque token in this codebase.
  portalPasswordHash        String?
  portalInvitationTokenHash String?   @unique
  portalInvitationExpiresAt DateTime?
  portalInvitedAt           DateTime?
  portalActivatedAt         DateTime?
  portalLastLoginAt         DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentals        Rental[]
  quotes         Quote[]
  documents      Document[]
  invoices       Invoice[]
  paymentDemands PaymentDemand[]

  portalRefreshTokens CustomerRefreshToken[]
  portalMessages      CustomerPortalMessage[]
  notifications       CustomerNotification[]
  extensionRequests   RentalExtensionRequest[]
  damageReports       RentalDamageReport[]

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, email])
  @@map("customers")
}

/// A universal, tenant-scoped classification for rentable assets. Deliberately
/// generic — "Vehicles", "Containers", "Generators" etc. are tenant-created
/// data, never hardcoded business logic. Supports nesting via parentId.
/// Name uniqueness within (tenantId, parentId) and cycle prevention are
/// enforced in AssetCategoriesService, not the database: Postgres unique
/// indexes treat NULL parentId values as distinct, so a DB-level constraint
/// alone cannot cover root-level (parentId IS NULL) siblings.
model AssetCategory {
  id          String    @id @default(uuid())
  tenantId    String
  parentId    String?
  name        String
  description String?
  code        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   AssetCategory?  @relation("AssetCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children AssetCategory[] @relation("AssetCategoryParent")

  assets                 Asset[]
  customFieldDefinitions AssetCustomFieldDefinition[]

  @@index([tenantId, parentId, name])
  @@index([tenantId, deletedAt])
  @@map("asset_categories")
}

/// Tenant-configurable lifecycle status for assets. Eight system statuses
/// (isSystem = true) are seeded automatically for every new tenant — see
/// AssetStatusesService.seedSystemStatuses — and cannot be renamed or
/// deleted. Tenants may additionally define their own custom statuses.
model AssetStatusDefinition {
  id                   String    @id @default(uuid())
  tenantId             String
  name                 String
  code                 String
  description          String?
  colorToken           String?
  icon                 String?
  isSystem             Boolean   @default(false)
  isActive             Boolean   @default(true)
  isAvailableForRental Boolean   @default(false)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  currentOnAssets Asset[] @relation("AssetCurrentStatus")

  statusHistoryFrom AssetStatusHistory[] @relation("AssetStatusHistoryFrom")
  statusHistoryTo   AssetStatusHistory[] @relation("AssetStatusHistoryTo")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("asset_status_definitions")
}

/// A tenant's rentable physical property of any kind — a vehicle, a
/// container, a generator, a tool, or anything else. Business logic here is
/// deliberately type-agnostic; type-specific attributes live in
/// AssetCustomFieldValue, never as columns on this table.
model Asset {
  id                    String    @id @default(uuid())
  tenantId              String
  categoryId            String
  currentStatusId       String
  name                  String
  internalNumber        String
  sku                   String?
  serialNumber          String?
  barcode               String?
  qrCodeValue           String?
  manufacturer          String?
  model                 String?
  description           String?
  purchaseDate          DateTime?
  purchasePriceMinor    Int?
  purchaseCurrency      String?   @db.VarChar(3)
  replacementValueMinor Int?
  replacementCurrency   String?   @db.VarChar(3)
  currentLocationText   String?
  conditionNotes        String?
  isRentable            Boolean   @default(true)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  createdByUserId       String
  updatedByUserId       String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      AssetCategory         @relation(fields: [categoryId], references: [id])
  currentStatus AssetStatusDefinition @relation("AssetCurrentStatus", fields: [currentStatusId], references: [id])
  createdByUser User                  @relation("AssetCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?                 @relation("AssetUpdatedBy", fields: [updatedByUserId], references: [id])

  customFieldValues     AssetCustomFieldValue[]
  statusHistory         AssetStatusHistory[]
  locationHistory       AssetLocationHistory[]
  availabilityBlocks    AssetAvailabilityBlock[]
  images                AssetImage[]
  documents             AssetDocument[]
  rentalItems           RentalItem[]
  quoteItems            QuoteItem[]
  /// Rows in the generic Document platform (contracts, protocols, damage
  /// reports, ...) that reference this asset — distinct from `documents`
  /// above (AssetDocument: manuals/certificates/insurance attached directly
  /// to the asset, unrelated to a rental/quote/document lifecycle).
  platformDocuments     Document[]
  platformDocumentItems DocumentItem[]
  damageReports         RentalDamageReport[]

  @@unique([tenantId, internalNumber])
  @@unique([tenantId, sku])
  @@unique([tenantId, serialNumber])
  @@unique([tenantId, barcode])
  @@unique([tenantId, qrCodeValue])
  @@index([tenantId, categoryId])
  @@index([tenantId, currentStatusId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, manufacturer])
  @@index([tenantId, model])
  @@map("assets")
}

/// Append-only record of every status transition for an asset. Written
/// atomically with the Asset.currentStatusId update in a single transaction.
model AssetStatusHistory {
  id              String   @id @default(uuid())
  tenantId        String
  assetId         String
  fromStatusId    String?
  toStatusId      String
  changedByUserId String
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromStatus    AssetStatusDefinition? @relation("AssetStatusHistoryFrom", fields: [fromStatusId], references: [id])
  toStatus      AssetStatusDefinition  @relation("AssetStatusHistoryTo", fields: [toStatusId], references: [id])
  changedByUser User                   @relation("AssetStatusHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, assetId, createdAt])
  @@map("asset_status_history")
}

/// Append-only record of every location change for an asset. Location is
/// deliberately a free-text field for now — see ADR 0002 for the documented
/// extension point toward branchId/warehouseId/GPS coordinates once those
/// concepts exist elsewhere in the platform.
model AssetLocationHistory {
  id               String   @id @default(uuid())
  tenantId         String
  assetId          String
  previousLocation String?
  newLocation      String?
  changedByUserId  String
  reason           String?
  createdAt        DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  changedByUser User   @relation("AssetLocationHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, assetId, createdAt])
  @@map("asset_location_history")
}

/// A time-bounded reason an asset is unavailable, independent of any Rental.
/// This is deliberately separate from Asset.currentStatusId: the current
/// status is a single global "right now" value with no date range, while a
/// block always has a concrete [startAt, endAt) window — a MAINTENANCE block
/// scheduled for next month must never make the asset look unavailable
/// today. AvailabilityService is the only place that reads this model; it
/// unions block conflicts with the existing RESERVED/ACTIVE RentalItem
/// conflicts to answer "is this asset free for this range" from one place.
/// relatedRentalId optionally links a REPAIR block created from a Return
/// Protocol back to the rental that surfaced the damage — informational
/// only, never required. Cancelling a block (cancelledAt set) is a soft
/// delete: the row is kept for audit/history, and AvailabilityService simply
/// excludes cancelled blocks from conflict queries.
model AssetAvailabilityBlock {
  id                String                     @id @default(uuid())
  tenantId          String
  assetId           String
  type              AssetAvailabilityBlockType
  startAt           DateTime
  endAt             DateTime
  notes             String?
  relatedRentalId   String?
  createdByUserId   String
  createdAt         DateTime                   @default(now())
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset           Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  relatedRental   Rental? @relation(fields: [relatedRentalId], references: [id], onDelete: SetNull)
  createdByUser   User    @relation("AssetAvailabilityBlockCreatedBy", fields: [createdByUserId], references: [id])
  cancelledByUser User?   @relation("AssetAvailabilityBlockCancelledBy", fields: [cancelledByUserId], references: [id])

  @@index([tenantId, assetId, cancelledAt])
  @@index([tenantId, startAt, endAt])
  @@map("asset_availability_blocks")
}

/// A tenant-defined custom attribute, optionally scoped to one AssetCategory
/// (categoryId = null means it applies to every asset regardless of
/// category). Values are stored per-asset in AssetCustomFieldValue as typed
/// JSON — see ADR 0003 for why EAV-via-JSON was chosen over per-type tables
/// or a fully dynamic schema.
model AssetCustomFieldDefinition {
  id              String         @id @default(uuid())
  tenantId        String
  categoryId      String?
  name            String
  key             String
  description     String?
  fieldType       AssetFieldType
  isRequired      Boolean        @default(false)
  isActive        Boolean        @default(true)
  isFilterable    Boolean        @default(false)
  isSearchable    Boolean        @default(false)
  sortOrder       Int            @default(0)
  validationRules Json?
  options         Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category AssetCategory?          @relation(fields: [categoryId], references: [id])
  values   AssetCustomFieldValue[]

  // Covers the categoryId != null case; the categoryId == null ("global")
  // case is enforced in AssetCustomFieldsService (see AssetCategory note
  // above re: NULL and unique indexes).
  @@unique([tenantId, categoryId, key])
  @@index([tenantId, fieldType])
  @@index([tenantId, categoryId, deletedAt])
  @@map("asset_custom_field_definitions")
}

/// The typed value of one custom field on one asset. valueJson always holds
/// a JSON-encodable representation appropriate to the field's fieldType
/// (string, number, boolean, ISO date string, or string[] for MULTISELECT).
model AssetCustomFieldValue {
  id                String   @id @default(uuid())
  tenantId          String
  assetId           String
  fieldDefinitionId String
  valueJson         Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset           Asset                      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fieldDefinition AssetCustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([assetId, fieldDefinitionId])
  @@index([tenantId, fieldDefinitionId])
  @@map("asset_custom_field_values")
}

/// Metadata for one image of an asset. The binary itself lives in
/// S3-compatible object storage (see StorageService / ADR 0005) — storageKey
/// is the only pointer to it. Only one non-deleted image per asset may have
/// isPrimary = true (enforced by AssetFilesService in a transaction, and by
/// a partial unique index added in the migration for defense in depth).
model AssetImage {
  id               String    @id @default(uuid())
  tenantId         String
  assetId          String
  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  sortOrder        Int       @default(0)
  isPrimary        Boolean   @default(false)
  altText          String?
  uploadedByUserId String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedByUser User   @relation("AssetImageUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, assetId, deletedAt])
  @@map("asset_images")
}

/// Metadata for one document attached to an asset (manual, certificate,
/// insurance, etc). Rental-specific documents (contracts) are explicitly out
/// of scope — see docs/adr/0005-asset-file-storage-strategy.md.
model AssetDocument {
  id               String            @id @default(uuid())
  tenantId         String
  assetId          String
  documentType     AssetDocumentType
  title            String
  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  expiresAt        DateTime?
  uploadedByUserId String
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedByUser User   @relation("AssetDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, assetId, deletedAt])
  @@map("asset_documents")
}

/// A tenant's rental order — the universal booking of one or more Assets to
/// one Customer over a shared planned date window. Never asset-type-specific
/// (see docs/adr/0006-rental-lifecycle-and-availability.md). Money is always
/// integer minor units in `currency`, matching every other module.
model Rental {
  id              String       @id @default(uuid())
  tenantId        String
  customerId      String
  rentalNumber    String
  status          RentalStatus @default(DRAFT)
  plannedStart    DateTime
  plannedEnd      DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  currency        String       @db.VarChar(3)
  subtotalMinor   Int          @default(0)
  discountMinor   Int          @default(0)
  /// A computed aggregate (sum of each RentalItem's own taxRateBp applied
  /// to its own line total) — never a directly user-entered amount, same
  /// "server always recomputes, client input is only ever a rate" status
  /// as subtotalMinor/totalMinor. Rows written before the percentage-based
  /// tax model (see RentalItem.taxRateBp) keep whatever flat amount was
  /// manually entered back then, untouched (historical financial
  /// immutability).
  taxMinor        Int          @default(0)
  totalMinor      Int          @default(0)
  notes           String?
  internalNotes   String?
  /// Set when this Rental was created by converting an accepted Quote (see
  /// QuotesService.convertToRental / ADR 0007). Only the ASSET-type
  /// QuoteItems become RentalItem rows here — the full commercial breakdown
  /// (including non-asset lines) stays on the immutable source Quote,
  /// reachable through this link. Null for every Rental created directly.
  sourceQuoteId   String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdByUserId String
  updatedByUserId String?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id])
  createdByUser User     @relation("RentalCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?    @relation("RentalUpdatedBy", fields: [updatedByUserId], references: [id])
  sourceQuote   Quote?   @relation("QuoteConvertedToRental", fields: [sourceQuoteId], references: [id])

  items         RentalItem[]
  statusHistory RentalStatusHistory[]
  documents     Document[]
  invoices      Invoice[]

  portalMessages     CustomerPortalMessage[]
  extensionRequests  RentalExtensionRequest[]
  damageReports      RentalDamageReport[]
  availabilityBlocks AssetAvailabilityBlock[]
  deposit            RentalDeposit?
  /// The canonical Quote generated FROM this Rental via "Generate
  /// Commercial Quote" (QuotesService.createFromRental) — the inverse side
  /// of Quote.sourceRentalId. Distinct from sourceQuote above (that's the
  /// Quote this Rental itself was converted from, the opposite direction).
  generatedQuote     Quote?                   @relation("RentalGeneratedQuote")

  @@unique([tenantId, rentalNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, plannedStart, plannedEnd])
  @@map("rentals")
}

/// One asset booked within a Rental. quantity is a pricing multiplier only —
/// the current Asset model represents one serialized physical unit per row
/// (see ADR 0002), so availability/overlap checking is always per-assetId,
/// never divided by quantity. Exactly one of dailyPriceMinor/weeklyPriceMinor/
/// monthlyPriceMinor/customPriceMinor is meaningful, selected by billingMode.
model RentalItem {
  id                     String                  @id @default(uuid())
  tenantId               String
  rentalId               String
  assetId                String
  quantity               Int                     @default(1)
  billingMode            RentalBillingMode
  dailyPriceMinor        Int?
  weeklyPriceMinor       Int?
  monthlyPriceMinor      Int?
  customPriceMinor       Int?
  /// Snapshot of the tenant's monthly billing settings at the moment this
  /// item was last written (create, or full item replacement on update) —
  /// null unless billingMode is MONTHLY. Frozen deliberately: a later change
  /// to the tenant's RentalBillingSettings must never alter an already-priced
  /// item's stored totals (see ADR 0008). Combined with plannedStart/
  /// plannedEnd on the parent Rental, this fully reproduces the original
  /// monthly-unit/remaining-day split on demand.
  monthlyBillingStrategy MonthlyBillingStrategy?
  customMonthLengthDays  Int?
  /// Snapshot of how this item's leftover partial month is charged — see
  /// PartialMonthPolicy and DECISIONS.md D-072. Same freeze-at-write-time
  /// rule as monthlyBillingStrategy above; null (pre-existing rows) behaves
  /// as PRORATE_BY_DAY, the calculation those rows were actually priced
  /// under.
  partialMonthPolicy     PartialMonthPolicy?
  /// Integer basis points (2300 = 23.00%) — mirrors QuoteItem.taxRateBp's
  /// exact convention (see quote-pricing.util.ts). Replaces the old
  /// Rental-header flat `taxMinor` manual-amount input: tax is now always
  /// a rate applied per line, computed server-side, never a number the
  /// user must calculate themselves (see docs/DECISIONS.md, rental tax
  /// percentage model). Defaults to 0 so every pre-migration row (which
  /// had no rate at all) keeps computing to zero additional tax — their
  /// already-stored `Rental.taxMinor` amount is left untouched by this
  /// migration (historical financial immutability, ARCHITECTURE_LOCK
  /// §1.5); only a future explicit item resubmission recomputes it.
  taxRateBp              Int                     @default(0)
  depositMinor           Int                     @default(0)
  discountMinor          Int                     @default(0)
  notes                  String?
  returnedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id])

  documentItems DocumentItem[]
  invoiceItems  InvoiceItem[]

  @@index([tenantId, rentalId])
  @@index([tenantId, assetId])
  @@map("rental_items")
}

/// Tenant-scoped monthly billing configuration for Rentals (TASK-0006
/// improvement — see ADR 0008). Deliberately a separate one-row-per-tenant
/// table rather than fields on Tenant itself: it's optional configuration,
/// not core tenant identity, and a missing row is a valid, meaningful state
/// (the tenant has never customized billing) rather than an error — see
/// RentalBillingSettingsService.getEffective, which defaults to
/// CALENDAR_MONTH/null when no row exists. This means every tenant that
/// existed before this table was added keeps CALENDAR_MONTH behavior
/// automatically, with no data migration required.
model RentalBillingSettings {
  id                     String                 @id @default(uuid())
  tenantId               String                 @unique
  monthlyBillingStrategy MonthlyBillingStrategy @default(CALENDAR_MONTH)
  /// Required by the service layer only when monthlyBillingStrategy = CUSTOM
  /// (1-365); ignored/must be null otherwise. Not enforced at the DB level
  /// since Postgres CHECK constraints referencing another column in the
  /// same row are more brittle to evolve than application-layer validation
  /// here, consistent with how QuoteItem's type-dependent fields are handled.
  customMonthLengthDays  Int?
  /// Tenant-wide default for how a MONTHLY item's leftover partial period is
  /// charged — see PartialMonthPolicy. Individual Quote/Rental items may
  /// override this per item at creation time (see DECISIONS.md D-072);
  /// this is only the pre-filled default. PRORATE_BY_DAY preserves the
  /// original behavior for every tenant that existed before this field.
  partialMonthPolicy     PartialMonthPolicy     @default(PRORATE_BY_DAY)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("rental_billing_settings")
}

/// Backs concurrency-safe RNT-###### rental number generation — one
/// counter row per tenant (never year-based, matching the existing
/// documented format), incremented atomically via a single
/// `INSERT ... ON CONFLICT ("tenantId") DO UPDATE ... RETURNING` (see
/// rental-numbering.util.ts). Mirrors QuoteSequence's proven pattern; the
/// counter never decrements, so a deleted/cancelled rental's number is
/// never reused.
model RentalSequence {
  id         String @id @default(uuid())
  tenantId   String @unique
  lastNumber Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("rental_sequences")
}

/// Append-only history of Rental.status transitions, written atomically with
/// the status change itself (single transaction — see RentalsService).
model RentalStatusHistory {
  id              String        @id @default(uuid())
  tenantId        String
  rentalId        String
  fromStatus      RentalStatus?
  toStatus        RentalStatus
  changedByUserId String
  reason          String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental        Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  changedByUser User   @relation("RentalStatusHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, rentalId, createdAt])
  @@map("rental_status_history")
}

/// The accounting record for a Rental's security deposit — deliberately
/// separate from RentalItem.depositMinor (which stays exactly as-is: the
/// *required* amount quoted/priced per item, shown as "Amount due at start"
/// alongside the taxable rental total, see docs/DECISIONS.md). This model
/// tracks what actually happened to that money: whether it was received, by
/// what method, and — at return — how much was given back vs. retained and
/// why. A refundable deposit is a balance-sheet liability while held, not
/// taxable rental revenue (see docs/DECISIONS.md D-097); only a retained
/// amount becomes a real charge, and that is invoiced through the normal
/// Invoice pipeline as its own line, never silently reclassified here. One
/// row per Rental (nullable 1:1 — most rentals have no deposit recorded
/// until staff explicitly records receipt).
model RentalDeposit {
  id                  String         @id @default(uuid())
  tenantId            String
  rentalId            String         @unique
  /// Snapshot of the required amount at the moment receipt was recorded
  /// (normally the sum of RentalItem.depositMinor at that time) — frozen
  /// for the same historical-immutability reason every other financial
  /// snapshot in this schema is frozen.
  requiredAmountMinor Int
  currency            String         @db.VarChar(3)
  receivedAt          DateTime?
  receivedAmountMinor Int?
  receivedMethod      PaymentMethod?
  receivedReference   String?
  returnedAt          DateTime?
  returnedAmountMinor Int?
  retainedAmountMinor Int?
  retentionReason     String?
  notes               String?
  createdByUserId     String
  updatedByUserId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental        Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  createdByUser User      @relation("RentalDepositCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?     @relation("RentalDepositUpdatedBy", fields: [updatedByUserId], references: [id])
  /// Payments funded by reallocating this held deposit (see
  /// PaymentsService.applyDeposit) — how much has already been applied is
  /// always the live sum of these rows, never a separately stored running
  /// total, matching every other derived-not-stored total in this schema.
  applications  Payment[]

  @@index([tenantId, rentalId])
  /// Backs Financial Reports & Analytics V1's "deposits received in range"
  /// query (FinanceReportsService.getDepositSummary) — see docs/DECISIONS.md.
  @@index([tenantId, receivedAt])
  @@map("rental_deposits")
}

/// A tenant's commercial offer to a Customer — assets, generic products or
/// services, delivery/labor/fee lines, pricing, discounts, tax, deposits,
/// and terms — prepared before any Rental is created. Never reserves an
/// asset by itself (see AvailabilityService integration in QuotesService);
/// only converting an ACCEPTED quote creates a real Rental. See
/// docs/adr/0007-quotes-and-commercial-offers.md.
model Quote {
  id                    String             @id @default(uuid())
  tenantId              String
  customerId            String
  quoteNumber           String
  status                QuoteStatus        @default(DRAFT)
  issueDate             DateTime
  validUntil            DateTime
  plannedStart          DateTime
  plannedEnd            DateTime
  currency              String             @db.VarChar(3)
  subtotalMinor         Int                @default(0)
  discountType          QuoteDiscountType?
  discountValue         Int                @default(0)
  discountTotalMinor    Int                @default(0)
  taxTotalMinor         Int                @default(0)
  depositTotalMinor     Int                @default(0)
  totalMinor            Int                @default(0)
  customerNotes         String?
  internalNotes         String?
  termsAndConditions    String?
  acceptedAt            DateTime?
  /// Free-text name/email captured at acceptance time — the public flow has
  /// no authenticated User to reference, so this is never a User FK.
  acceptedBy            String?
  rejectedAt            DateTime?
  rejectionReason       String?
  /// SHA-256 hash of the current public access token (see TokenService's
  /// identical hashing convention for refresh tokens) — the plaintext token
  /// is never stored. One active token at a time; regenerated on every send.
  publicTokenHash       String?            @unique
  publicTokenExpiresAt  DateTime?
  /// Lineage pointer set by QuotesService.duplicate — deliberately just a
  /// single self-relation, not a full revision chain (see ADR 0007).
  duplicatedFromQuoteId String?
  /// Set when this Quote was generated FROM an existing Rental (staff
  /// clicked "Generate Commercial Quote" on the Rental Workspace) — the
  /// mirror-image relation of Rental.sourceQuoteId (Quote -> Rental via
  /// acceptance/conversion). @unique makes quote-generation idempotent:
  /// QuotesService.createFromRental reuses the existing Quote instead of
  /// creating a duplicate on a repeat click. Null for every Quote created
  /// directly (the normal case) or reached via QuotesService.convertToRental
  /// (that direction is recorded on Rental.sourceQuoteId instead — a Quote
  /// is never both a Rental's source AND generated from that same Rental).
  sourceRentalId        String?            @unique
  createdByUserId       String
  updatedByUserId       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer @relation(fields: [customerId], references: [id])
  createdByUser       User     @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser       User?    @relation("QuoteUpdatedBy", fields: [updatedByUserId], references: [id])
  duplicatedFromQuote Quote?   @relation("QuoteDuplicatedFrom", fields: [duplicatedFromQuoteId], references: [id])
  duplicates          Quote[]  @relation("QuoteDuplicatedFrom")
  /// Populated once this quote has been converted — the created Rental
  /// holds the FK (Rental.sourceQuoteId); this is the derived inverse side.
  convertedRental     Rental?  @relation("QuoteConvertedToRental")
  sourceRental        Rental?  @relation("RentalGeneratedQuote", fields: [sourceRentalId], references: [id])

  items             QuoteItem[]
  statusHistory     QuoteStatusHistory[]
  documents         QuoteDocument[]
  /// Rows in the generic Document platform (e.g. a CONTRACT generated from
  /// this accepted quote) — distinct from `documents` above (QuoteDocument:
  /// this quote's own generated PDF).
  platformDocuments Document[]
  invoices          Invoice[]
  emailDeliveries   QuoteEmailDelivery[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, issueDate])
  @@index([tenantId, validUntil])
  @@index([tenantId, plannedStart, plannedEnd])
  @@index([tenantId, totalMinor])
  @@index([tenantId, createdByUserId])
  @@map("quotes")
}

/// One line on a Quote — either a physical Asset (assetId set, itemType
/// ASSET) or a generic product/service/fee/delivery/collection/labor/custom
/// line (assetId null). Exactly one of dailyPriceMinor/weeklyPriceMinor/
/// monthlyPriceMinor/customPriceMinor/unitPriceMinor is meaningful,
/// selected by billingMode (FLAT uses unitPriceMinor * quantity, the other
/// four modes mirror RentalItem's pricing exactly — see quote-pricing.util.ts).
model QuoteItem {
  id                     String                  @id @default(uuid())
  tenantId               String
  quoteId                String
  itemType               QuoteItemType
  assetId                String?
  name                   String
  description            String?
  quantity               Int                     @default(1)
  /// Free-text unit label for display only (e.g. "day", "hour", "piece") —
  /// never used in price computation, which is driven by billingMode.
  unit                   String?
  billingMode            QuoteBillingMode
  unitPriceMinor         Int?
  dailyPriceMinor        Int?
  weeklyPriceMinor       Int?
  monthlyPriceMinor      Int?
  customPriceMinor       Int?
  /// Snapshot of the tenant's monthly billing settings (RentalBillingSettings
  /// — shared with Rentals, see ADR 0008) at the moment this item was last
  /// written (create, or full item replacement on update, or the exact
  /// value copied verbatim on duplicate) — null unless billingMode is
  /// MONTHLY. A row created before this column existed has both fields
  /// null even though billingMode may be MONTHLY; QuotesService treats a
  /// null strategy on an existing MONTHLY item as "legacy — display and
  /// reproduce using the whole-month rounding it was actually priced
  /// with" rather than silently recalculating it under a strategy it was
  /// never priced under. Frozen deliberately: a later change to the
  /// tenant's RentalBillingSettings must never alter an already-priced
  /// item's stored totals.
  monthlyBillingStrategy MonthlyBillingStrategy?
  customMonthLengthDays  Int?
  /// Snapshot of how this item's leftover partial month is charged — see
  /// PartialMonthPolicy and DECISIONS.md D-072. Same null-means-legacy
  /// freeze-at-write-time rule as monthlyBillingStrategy above.
  partialMonthPolicy     PartialMonthPolicy?
  discountType           QuoteDiscountType?
  discountValue          Int                     @default(0)
  discountTotalMinor     Int                     @default(0)
  /// Integer basis points (2000 = 20.00%) — never a float rate.
  taxRateBp              Int                     @default(0)
  taxTotalMinor          Int                     @default(0)
  depositMinor           Int                     @default(0)
  lineSubtotalMinor      Int                     @default(0)
  lineTotalMinor         Int                     @default(0)
  sortOrder              Int                     @default(0)
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  asset  Asset? @relation(fields: [assetId], references: [id])

  @@index([tenantId, quoteId])
  @@index([tenantId, assetId])
  @@map("quote_items")
}

/// Append-only history of Quote.status transitions. changedByUserId is
/// nullable (unlike RentalStatusHistory's required field) because the
/// public accept/reject flow has no authenticated User — reason captures
/// context instead (e.g. "Accepted via public link").
model QuoteStatusHistory {
  id              String       @id @default(uuid())
  tenantId        String
  quoteId         String
  fromStatus      QuoteStatus?
  toStatus        QuoteStatus
  changedByUserId String?
  reason          String?
  metadata        Json?
  createdAt       DateTime     @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote         Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changedByUser User?  @relation("QuoteStatusHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, quoteId, createdAt])
  @@map("quote_status_history")
}

/// Metadata for one generated PDF of a Quote. The binary lives in
/// S3-compatible object storage (StorageService, ADR 0005) — storageKey is
/// the only pointer. A new row is created on every (re)generation; the most
/// recent non-deleted row is what GET .../pdf serves.
model QuoteDocument {
  id                String    @id @default(uuid())
  tenantId          String
  quoteId           String
  storageKey        String
  originalFileName  String
  mimeType          String
  sizeBytes         Int
  generatedByUserId String?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote           Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  generatedByUser User?  @relation("QuoteDocumentGeneratedBy", fields: [generatedByUserId], references: [id])

  @@index([tenantId, quoteId, deletedAt])
  @@map("quote_documents")
}

/// A per-tenant-per-year atomic counter backing quoteNumber generation
/// (format Q-2026-000001). Incremented via a single Postgres
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` (see
/// quote-numbering.util.ts) — genuinely concurrency-safe, unlike Rental's
/// existing count-then-check generateRentalNumber. Never decremented, so a
/// cancelled/deleted quote's number is never reused.
model QuoteSequence {
  id         String @id @default(uuid())
  tenantId   String
  year       Int
  lastNumber Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year])
  @@map("quote_sequences")
}

// ===========================================================================
// Document Management Platform (TASK-0008 Part 1 — Architecture & Domain
// Model only; no visual layouts/rendering yet). See
// docs/adr/0010-document-management-platform.md for the full rationale.
// ===========================================================================

/// A generic business document of any DocumentType — the single model every
/// document-producing workflow (contracts, handover/return protocols,
/// damage reports, amendments, future types) is built on, so a new document
/// type never requires a schema change. Deliberately holds no type-specific
/// columns: type-specific structured content lives in
/// DocumentVersion.businessDataSnapshot / DocumentItem.dataJson (see the
/// "Business Data" separation below), never as columns here.
///
/// Every reference is optional except tenant/creator, since not every
/// document type needs every reference (a DAMAGE_REPORT needs an assetId, a
/// CONTRACT_AMENDMENT needs none of rental/asset). "Organization" from the
/// task's reference list is deliberately not a separate field — this
/// codebase has no Organization entity distinct from Tenant (see ADR 0010);
/// tenantId already is that reference. "Employee" is employeeUserId: the
/// staff member who performed the real-world action the document records
/// (e.g. the technician who ran a handover), distinct from createdByUserId
/// (who authored the database row — usually the same person, but not
/// necessarily, e.g. a manager creating a protocol on a technician's behalf).
model Document {
  id             String         @id @default(uuid())
  tenantId       String
  documentType   DocumentType
  /// Free-text label only meaningful (and only ever set) when
  /// documentType = CUSTOM — mirrors QuoteItemType's CUSTOM convention.
  customTypeName String?
  documentNumber String
  status         DocumentStatus @default(DRAFT)
  title          String?

  customerId     String?
  rentalId       String?
  quoteId        String?
  assetId        String?
  employeeUserId String?

  /// Denormalized pointer to the highest DocumentVersion.versionNumber for
  /// this document — a cheap read-side convenience; DocumentVersion rows
  /// remain the source of truth and this is always kept in sync with them
  /// in the same transaction that creates a version.
  currentVersionNumber Int @default(1)

  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer? @relation(fields: [customerId], references: [id])
  rental        Rental?   @relation(fields: [rentalId], references: [id])
  quote         Quote?    @relation(fields: [quoteId], references: [id])
  asset         Asset?    @relation(fields: [assetId], references: [id])
  employeeUser  User?     @relation("DocumentEmployee", fields: [employeeUserId], references: [id])
  createdByUser User      @relation("DocumentCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?     @relation("DocumentUpdatedBy", fields: [updatedByUserId], references: [id])

  versions          DocumentVersion[]
  items             DocumentItem[]
  statusHistory     DocumentStatusHistory[]
  emailDeliveries   DocumentEmailDelivery[]
  signatureRequests DocumentSignatureRequest[]
  signatureEvidence DocumentSignatureEvidence[]

  /// Set on the RentalDamageReport this Document formalizes, when a
  /// customer-submitted report was converted by staff (see
  /// RentalDamageReport.convertedDocumentId).
  damageReportSource RentalDamageReport?

  @@unique([tenantId, documentNumber])
  @@index([tenantId, documentType])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, rentalId])
  @@index([tenantId, quoteId])
  @@index([tenantId, assetId])
  @@index([tenantId, deletedAt])
  @@map("documents")
}

/// One immutable-once-finalized version of a Document's business data —
/// the "Version" and "Business Data" layers, deliberately separate from
/// "Template" (templateId) and "Rendering/Storage" (the DocumentFile rows
/// below), per the task's explicit "never mix them" instruction.
///
/// Version 1 is created alongside the Document itself and starts mutable
/// (isFinal = false) while the document is DRAFT — DocumentsService.update
/// edits this version's businessDataSnapshot in place. The moment the
/// document's status leaves DRAFT, that version is finalized (isFinal =
/// true, finalizedAt set) and becomes permanently immutable: it is never
/// edited again, matching "business documents are legal records ... never
/// edit finalized documents." Any later correction creates a brand new
/// version (parentVersionId = the version being corrected, reason required)
/// via DocumentsService.createVersion, which also resets the document to
/// DRAFT so the new version can itself be reviewed and finalized again.
/// Every version, finalized or not, is preserved forever — never deleted.
model DocumentVersion {
  id              String  @id @default(uuid())
  tenantId        String
  documentId      String
  versionNumber   Int
  parentVersionId String?

  /// The structured business data this version represents, as JSON —
  /// deliberately untyped/universal at the schema level (see ADR 0010):
  /// a CONTRACT's data shape and a DAMAGE_REPORT's data shape are nothing
  /// alike, and hardcoding either as columns here would violate "everything
  /// must support every rental business" the moment a new document type is
  /// added. Server-side DTOs validate shape at the API boundary; this
  /// column itself accepts any JSON object.
  businessDataSnapshot Json

  templateId        String?
  /// Which exact DocumentTemplateVersion was current when this version was
  /// created — captured once, at creation time, the same "capture now"
  /// pattern businessDataSnapshot already uses. DocumentRendererService
  /// resolves this pinned version unconditionally when set, so a later
  /// edit to the template (which always creates a NEW
  /// DocumentTemplateVersion, never mutates one in place) can never
  /// silently change how an already-generated document re-renders — the
  /// actual enforcement of the "finalized forever" promise ARCHITECTURE_LOCK
  /// §1.6 and D-022 already make. Null on every DocumentVersion created
  /// before this column existed, which keeps resolving the template's
  /// current version exactly as before (fully backward compatible, no
  /// backfill).
  templateVersionId String?
  isFinal           Boolean   @default(false)
  finalizedAt       DateTime?
  /// Why this version was created — required for every version after the
  /// first (a correction must explain itself); null for the initial version
  /// created alongside the Document.
  reason            String?

  createdByUserId String
  createdAt       DateTime @default(now())

  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document              Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentVersion         DocumentVersion?         @relation("DocumentVersionParent", fields: [parentVersionId], references: [id])
  childVersions         DocumentVersion[]        @relation("DocumentVersionParent")
  template              DocumentTemplate?        @relation(fields: [templateId], references: [id])
  pinnedTemplateVersion DocumentTemplateVersion? @relation("DocumentVersionPinnedTemplateVersion", fields: [templateVersionId], references: [id])
  createdByUser         User                     @relation("DocumentVersionCreatedBy", fields: [createdByUserId], references: [id])

  files             DocumentFile[]
  shareLinks        DocumentShareLink[]
  emailDeliveries   DocumentEmailDelivery[]
  signatureRequests DocumentSignatureRequest[]
  signatureEvidence DocumentSignatureEvidence[]

  @@unique([documentId, versionNumber])
  @@index([tenantId, documentId])
  @@map("document_versions")
}

/// One rendered or uploaded file belonging to a specific DocumentVersion —
/// the "Rendering/Storage" layer. Mirrors QuoteDocument/AssetDocument
/// exactly (storageKey/originalFileName/mimeType/sizeBytes, StorageService
/// as the only thing that touches actual bytes — see ADR 0005 — so this
/// platform is never tied to local-filesystem storage). `format`
/// distinguishes a system-generated rendering (PDF/HTML/JSON_SNAPSHOT) from
/// a staff-uploaded supporting file (ATTACHMENT/PHOTO); uploadedByUserId is
/// null for system-generated renderings and set for staff uploads.
model DocumentFile {
  id                String                      @id @default(uuid())
  tenantId          String
  documentVersionId String
  format            DocumentFileFormat
  storageKey        String
  originalFileName  String
  mimeType          String
  sizeBytes         Int
  /// SHA-256 hex digest of the exact stored bytes at storageKey — tamper
  /// evidence only (docs/PRODUCT_BIBLE.md "Havelio Signature System"),
  /// never a qualified/cryptographic signature. Populated for every
  /// system-generated PDF rendering (see DocumentPdfService); null for
  /// staff-uploaded ATTACHMENT/PHOTO files and for any row written before
  /// this column existed.
  sha256            String?
  /// Staff-uploaded ATTACHMENT/PHOTO only — see DocumentAttachmentCategory.
  /// Always null for system-generated renderings.
  category          DocumentAttachmentCategory?
  /// Optional staff-entered caption ("Front bumper, minor scratch") — never
  /// required, never system-generated.
  caption           String?
  uploadedByUserId  String?
  createdAt         DateTime                    @default(now())
  deletedAt         DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  uploadedByUser  User?           @relation("DocumentFileUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, documentVersionId, deletedAt])
  @@map("document_files")
}

/// A minimal, tenant-scoped template registry — the "Template" layer.
/// TASK-0008 Part 1 deliberately does not implement template authoring or
/// a rendering engine (no content/body field exists yet); this table exists
/// so DocumentVersion.templateId has a real, structural extension point to
/// reference once template content and rendering are built in a later part,
/// without a schema change at that point.
model DocumentTemplate {
  id                   String                 @id @default(uuid())
  tenantId             String
  documentType         DocumentType
  name                 String
  description          String?
  /// The document-language this template's content is authored in (a
  /// SupportedLanguage code from packages/localization, e.g. "de") — null
  /// means "any/tenant default", the behavior every template had before
  /// this field existed. Conceptually independent from a staff member's
  /// UI language (see PRODUCT_BIBLE.md §28) — a Ukrainian-UI staff member
  /// can generate a German-language contract for a German customer by
  /// activating a `language: "de"` CONTRACT template.
  language             String?
  /// Draft while being authored; at most one ACTIVE template per
  /// (tenantId, documentType, language) — enforced transactionally in
  /// DocumentTemplatesService.activate (mirrors AssetFilesService's
  /// isPrimary-image enforcement) and by a partial unique index for
  /// defense in depth. Archived templates are retained for history but
  /// can no longer be activated or used to render new documents.
  status               DocumentTemplateStatus @default(DRAFT)
  /// Denormalized pointer to the highest DocumentTemplateVersion.versionNumber
  /// — same cached-pointer convention as Document.currentVersionNumber.
  currentVersionNumber Int                    @default(1)
  createdByUserId      String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser            User                      @relation("DocumentTemplateCreatedBy", fields: [createdByUserId], references: [id])
  /// This template's own versioned HTML/CSS content (see
  /// DocumentTemplateVersion) — distinct from `renderedDocumentVersions`
  /// below, which are Document versions that were rendered *using* this
  /// template.
  versions                 DocumentTemplateVersion[]
  renderedDocumentVersions DocumentVersion[]

  @@index([tenantId, documentType, status])
  @@map("document_templates")
}

/// One immutable version of a DocumentTemplate's own HTML/CSS content —
/// mirrors DocumentVersion's shape exactly (versionNumber, immutable once
/// created, never edited). Editing a template's content always creates a
/// new version; "Restore previous version" (see TASK-0008 Part 2) simply
/// creates a fresh version copying an older one's content, the same
/// "correction" pattern DocumentsService.createVersion already uses.
model DocumentTemplateVersion {
  id            String @id @default(uuid())
  tenantId      String
  templateId    String
  versionNumber Int

  /// The raw HTML body, containing `{{variable.path}}` placeholders
  /// resolved by VariableResolverService/renderTemplate at render time —
  /// see docs/adr/0011-document-rendering-and-sharing.md.
  htmlContent     String
  /// Optional additional CSS layered on top of the shared base stylesheet
  /// (see apps/api/src/documents/rendering/base-document.css) — null uses
  /// the base styling unmodified.
  css             String?
  /// Purely for the template editor UI, never validated against at render
  /// time (the variable system is deliberately open-ended — see Part 2 of
  /// ADR 0011). Historically an unused declarative variable-path list;
  /// the no-code template builder repurposes this same column to persist
  /// its block-editor structure as `{ editorFormat: "blocks-v1", blocks:
  /// [...] }` so a template can be reopened for visual editing — a
  /// template whose `variablesSchema` doesn't match that shape (including
  /// every pre-existing template) simply opens in Advanced/Code mode,
  /// which edits `htmlContent`/`css` directly exactly as before.
  variablesSchema Json?

  createdByUserId String
  createdAt       DateTime @default(now())

  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template                 DocumentTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdByUser            User              @relation("DocumentTemplateVersionCreatedBy", fields: [createdByUserId], references: [id])
  pinnedByDocumentVersions DocumentVersion[] @relation("DocumentVersionPinnedTemplateVersion")

  @@unique([templateId, versionNumber])
  @@index([tenantId, templateId])
  @@map("document_template_versions")
}

/// Append-only history of Document.status transitions, mirroring
/// QuoteStatusHistory exactly — changedByUserId is nullable so a future
/// customer-facing signature/view flow (no authenticated User) can still
/// write history, the same reasoning ADR 0007 documents for quotes.
model DocumentStatusHistory {
  id              String          @id @default(uuid())
  tenantId        String
  documentId      String
  fromStatus      DocumentStatus?
  toStatus        DocumentStatus
  changedByUserId String?
  reason          String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  changedByUser User?    @relation("DocumentStatusHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([tenantId, documentId, createdAt])
  @@map("document_status_history")
}

/// One line of a multi-line/multi-asset Document (e.g. one row per asset on
/// a Handover Protocol covering a whole rental). Optional and independent of
/// Document.assetId: a single-asset document (e.g. one Damage Report about
/// one item) can use Document.assetId alone with no items; a multi-asset
/// document uses one DocumentItem per asset/line instead. dataJson is the
/// same deliberately universal, type-agnostic escape hatch as
/// DocumentVersion.businessDataSnapshot — e.g. per-asset condition/damage
/// details — never hardcoded columns, for the same "every rental business"
/// reason.
model DocumentItem {
  id           String   @id @default(uuid())
  tenantId     String
  documentId   String
  assetId      String?
  rentalItemId String?
  description  String?
  dataJson     Json?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  asset      Asset?      @relation(fields: [assetId], references: [id])
  rentalItem RentalItem? @relation(fields: [rentalItemId], references: [id])

  @@index([tenantId, documentId])
  @@index([tenantId, assetId])
  @@map("document_items")
}

/// Backs concurrency-safe document number generation, one counter per
/// (tenantId, documentType, year) — mirroring QuoteSequence/RentalSequence's
/// proven atomic-upsert pattern (see document-numbering.util.ts). `year` is
/// a required Int, not nullable: Postgres unique constraints treat every
/// NULL as distinct from every other NULL, which would silently break the
/// `ON CONFLICT` upsert's atomicity for non-year-scoped document types (two
/// concurrent inserts with year = NULL would never conflict with each
/// other). Non-year-scoped types instead use the sentinel value 0, which
/// behaves as a normal, equal-to-itself value in the unique index.
model DocumentSequence {
  id           String       @id @default(uuid())
  tenantId     String
  documentType DocumentType
  year         Int
  lastNumber   Int          @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType, year])
  @@map("document_sequences")
}

// ===========================================================================
// TASK-0008 Part 2 — Rendering, Templates, Public Sharing, Email, E-Signature
// See docs/adr/0011-document-rendering-and-sharing.md.
// ===========================================================================

/// A public, unauthenticated access link for one Document — mirrors
/// Quote.publicTokenHash's hashed-opaque-token convention exactly, but as
/// its own table (not a column on Document) since a document can have a
/// history of links (old ones disabled, not overwritten) and needs its own
/// counters. At most one ACTIVE (non-disabled, non-expired) link per
/// Document is enforced in DocumentSharingService — "regenerate" disables
/// the previous link and creates a new one, never mutates the old row's
/// token.
model DocumentShareLink {
  id                String @id @default(uuid())
  tenantId          String
  /// Which specific version was shared — a link always serves the version
  /// that was active when it was created, never silently upgrading to a
  /// later correction (consistent with historical-immutability elsewhere
  /// in this codebase).
  documentVersionId String

  /// SHA-256 hash of the opaque token embedded in the public URL — the
  /// plaintext token is never stored, same reasoning as
  /// quote-public-token.util.ts.
  tokenHash    String   @unique
  /// Optional extra protection: an argon2 hash of a short access password,
  /// reusing PasswordService (the same hashing this codebase already uses
  /// for User.passwordHash) rather than inventing a second scheme.
  passwordHash String?
  expiresAt    DateTime

  viewCount      Int       @default(0)
  downloadCount  Int       @default(0)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  /// Set when explicitly disabled (or superseded by a regenerated link);
  /// null means still potentially usable (still subject to expiresAt).
  disabledAt     DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  createdByUser   User            @relation("DocumentShareLinkCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId, documentVersionId])
  @@map("document_share_links")
}

/// One email send attempt for a Document — kept as its own row (rather than
/// only an AuditLog entry, unlike Quotes' send-email logging) because
/// "retry" needs a concrete, re-sendable resource: the original recipient/
/// subject/message/attachment choice, looked up by id after the fact.
model DocumentEmailDelivery {
  id                String                     @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  recipientType     DocumentEmailRecipientType
  recipientEmail    String
  subject           String
  message           String?
  status            DocumentEmailStatus        @default(PENDING)
  errorMessage      String?
  errorCategory     EmailErrorCategory?
  /// Present only once a real (non-logging) provider actually accepts the
  /// message — the transport-level id (e.g. SMTP's returned Message-ID),
  /// never fabricated. Null for NOT_CONFIGURED/FAILED and for every send
  /// made before this field existed.
  providerMessageId String?
  sentByUserId      String
  createdAt         DateTime                   @default(now())
  sentAt            DateTime?
  /// Set only when status transitions to FAILED — distinct from `sentAt` so
  /// "when did we last try" is always answerable even on failure.
  failedAt          DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  sentByUser      User            @relation("DocumentEmailDeliverySentBy", fields: [sentByUserId], references: [id])

  @@index([tenantId, documentId, createdAt])
  @@map("document_email_deliveries")
}

/// Same truthful-delivery-tracking shape as DocumentEmailDelivery
/// (PRE-CHAPTER-10 production-infrastructure pass), for Quote — which is
/// deliberately NOT a Document row (see D-081) so it needed its own table
/// rather than widening DocumentEmailDelivery's FK. QuotesService.send()
/// already flips Quote.status to SENT independently of email delivery
/// (unchanged, existing behavior) — this table exists purely so a failed or
/// unconfigured email attempt is persisted/retryable/visible, not silently
/// dropped to only an audit-log line as it was before this pass.
model QuoteEmailDelivery {
  id                String              @id @default(uuid())
  tenantId          String
  quoteId           String
  recipientEmail    String
  subject           String
  message           String?
  status            DocumentEmailStatus @default(PENDING)
  errorMessage      String?
  errorCategory     EmailErrorCategory?
  providerMessageId String?
  sentByUserId      String
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote      Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sentByUser User   @relation("QuoteEmailDeliverySentBy", fields: [sentByUserId], references: [id])

  @@index([tenantId, quoteId, createdAt])
  @@map("quote_email_deliveries")
}

/// Same truthful-delivery-tracking shape as DocumentEmailDelivery, for
/// Invoice — also deliberately standalone (D-081). Invoice previously had
/// no real email-sending action at all (only `markSent`, a manual status
/// flip with no email dispatched); this is the first version that actually
/// sends anything. `markSent`/Invoice.status stay untouched — email
/// delivery is tracked independently, same separation as Quote/Document.
model InvoiceEmailDelivery {
  id                String              @id @default(uuid())
  tenantId          String
  invoiceId         String
  recipientEmail    String
  subject           String
  message           String?
  status            DocumentEmailStatus @default(PENDING)
  errorMessage      String?
  errorCategory     EmailErrorCategory?
  providerMessageId String?
  sentByUserId      String
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentByUser User    @relation("InvoiceEmailDeliverySentBy", fields: [sentByUserId], references: [id])

  @@index([tenantId, invoiceId, createdAt])
  @@map("invoice_email_deliveries")
}

/// Generated, sent — a Payment Demand is created once with everything it
/// needs already frozen and is never edited afterward; a mistaken one is
/// simply not sent, or a corrected new one is generated.
enum PaymentDemandStatus {
  GENERATED
  SENT
}

/// Havelio Payments & Receivables — International Payment Demand Foundation
/// (docs/PRODUCT_BIBLE.md, docs/DECISIONS.md). A country-aware formal
/// collection notice for an overdue Invoice — deliberately NOT a
/// Poland-only "Wezwanie do zapłaty": that is only the Polish PRESENTATION
/// (see `countryCode` + payment-demand-renderer.service.ts's template
/// registry), never a hard-coded global concept. Modeled the same way as
/// Invoice (its own first-class object, its own numbering, its own frozen
/// snapshot) rather than through the generic Document `{{placeholder}}`
/// platform, for the same reason Invoice isn't: it needs its own
/// country/amount-breakdown-specific data shape, not a Rental-shaped
/// variable set (see docs/DECISIONS.md). Every amount/date field below is
/// a snapshot captured at generation time — exactly like
/// Invoice.sellerSnapshot/buyerSnapshot/bankSnapshot — so a demand's
/// rendered PDF is byte-for-byte reproducible forever regardless of any
/// later payment, void, or Company Profile edit; it reflects the true state
/// of the debt at the moment it was issued, on purpose. Always references
/// exactly one Invoice — the authoritative receivable in this codebase
/// (see docs/DECISIONS.md) — never a Rental directly.
model PaymentDemand {
  id           String              @id @default(uuid())
  tenantId     String
  customerId   String
  invoiceId    String
  demandNumber String
  status       PaymentDemandStatus @default(GENERATED)

  /// The tenant's company country at generation time — selects which
  /// wordingtemplate rendered this demand (see
  /// payment-demand-renderer.service.ts). Frozen: a later Company Profile
  /// country change never changes how an already-generated demand reads.
  countryCode      String @db.VarChar(2)
  documentLanguage String @db.VarChar(10)

  issueDate         DateTime
  /// Copied from Invoice.dueDate at generation time — frozen, see model doc.
  originalDueDate   DateTime?
  /// The new deadline staff is giving the customer in this demand — a
  /// plain staff-entered date, never auto-computed from a jurisdiction's
  /// statutory grace period (no such calculation exists yet, see
  /// docs/DECISIONS.md).
  requestedDeadline DateTime

  currency               String @db.VarChar(3)
  originalAmountMinor    Int
  paidAmountMinor        Int
  outstandingAmountMinor Int

  creditorSnapshot Json
  debtorSnapshot   Json
  bankSnapshot     Json?

  createdByUserId String
  createdAt       DateTime  @default(now())
  sentAt          DateTime?

  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer                     @relation(fields: [customerId], references: [id])
  invoice         Invoice                      @relation(fields: [invoiceId], references: [id])
  createdByUser   User                         @relation("PaymentDemandCreatedBy", fields: [createdByUserId], references: [id])
  emailDeliveries PaymentDemandEmailDelivery[]

  @@unique([tenantId, demandNumber])
  @@index([tenantId, invoiceId])
  @@index([tenantId, customerId])
  @@map("payment_demands")
}

/// Backs concurrency-safe demand-number generation — identical pattern to
/// InvoiceSequence/QuoteSequence (one counter row per tenant/year/month).
model PaymentDemandSequence {
  id         String @id @default(uuid())
  tenantId   String
  year       Int
  month      Int
  lastNumber Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@map("payment_demand_sequences")
}

/// Mirrors InvoiceEmailDelivery exactly — see that model's doc comment for
/// the truthful-delivery-status rationale (never a fabricated SENT).
model PaymentDemandEmailDelivery {
  id                String              @id @default(uuid())
  tenantId          String
  paymentDemandId   String
  recipientEmail    String
  subject           String
  message           String?
  status            DocumentEmailStatus @default(PENDING)
  errorMessage      String?
  errorCategory     EmailErrorCategory?
  providerMessageId String?
  sentByUserId      String
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentDemand PaymentDemand @relation(fields: [paymentDemandId], references: [id], onDelete: Cascade)
  sentByUser    User          @relation("PaymentDemandEmailDeliverySentBy", fields: [sentByUserId], references: [id])

  @@index([tenantId, paymentDemandId, createdAt])
  @@map("payment_demand_email_deliveries")
}

/// Tracks one e-signature request for a specific DocumentVersion, decoupled
/// from Document.status (which stays a coarse business-lifecycle field) —
/// see DocumentSignatureProvider/DocumentSignatureService and ADR 0011.
/// `provider` is LOCAL_MOCK for every request in Part 2 (no real provider
/// integration yet); `externalReference` is null until a real provider
/// exists to populate it.
model DocumentSignatureRequest {
  id                String                        @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  provider          DocumentSignatureProviderType @default(LOCAL_MOCK)
  status            DocumentSignatureStatus       @default(REQUESTED)
  signerName        String?
  signerEmail       String?
  externalReference String?
  requestedByUserId String
  requestedAt       DateTime                      @default(now())
  respondedAt       DateTime?
  expiresAt         DateTime?
  updatedAt         DateTime                      @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  requestedByUser User            @relation("DocumentSignatureRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([tenantId, documentId, requestedAt])
  @@map("document_signature_requests")
}

/// A tenant's reusable, company-level handwritten signature — configured
/// once in Settings -> Company Profile and optionally reused when staff
/// sign a Contract/Handover/Return "as the company" (see
/// DocumentSignatureEvidence, which copies this image's bytes into its own
/// row at the moment of use, so a later replacement here never changes an
/// already-signed document — docs/PRODUCT_BIBLE.md "Havelio Signature
/// System"). At most one row with deletedAt: null per tenant, enforced in
/// CompanySignatureService, not at the DB level (mirrors AssetImage's
/// single-`isPrimary`-per-scope convention). Replacing/deleting this row
/// never touches any DocumentSignatureEvidence row that already copied its
/// bytes elsewhere — see that model's own comment.
///
/// This is a plain visual handwritten signature (drawn or uploaded), never
/// a qualified electronic signature / eIDAS / PAdES / certificate-based
/// signature — see docs/PRODUCT_BIBLE.md.
model TenantSignature {
  id                  String                 @id @default(uuid())
  tenantId            String
  representativeName  String
  representativeTitle String?
  storageKey          String
  mimeType            String
  sizeBytes           Int
  checksumSha256      String
  method              SignatureCaptureMethod
  createdByUserId     String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@map("tenant_signatures")
}

/// The immutable per-document signature evidence snapshot — the "Document
/// Signature" concept in docs/PRODUCT_BIBLE.md "Havelio Signature System".
/// Created once when a signature is captured for a specific
/// Document/DocumentVersion and NEVER updated or deleted afterward
/// (append-only, the same durability guarantee DocumentStatusHistory
/// already has) — this is what makes an already-signed document keep
/// showing the exact signature that was used at signing time even if the
/// tenant's saved TenantSignature is later replaced or deleted, and even
/// if the customer signed with a one-off drawn signature never saved
/// anywhere else. At most one CUSTOMER and one TENANT_REPRESENTATIVE row
/// per documentId in the normal flow, enforced in the capturing service,
/// not the DB (a correction-version workflow may legitimately re-capture).
///
/// This is a plain visual handwritten signature (drawn/uploaded/reused
/// from the tenant's saved one), never a qualified electronic signature —
/// see docs/PRODUCT_BIBLE.md.
model DocumentSignatureEvidence {
  id                String                 @id @default(uuid())
  tenantId          String
  documentId        String
  documentVersionId String
  signerType        SignatureSignerType
  signerName        String
  signerTitle       String?
  signerEmail       String?
  method            SignatureCaptureMethod
  source            SignatureSource
  storageKey        String
  mimeType          String
  sizeBytes         Int
  checksumSha256    String
  /// The real UTC instant the signature was captured — see
  /// docs/PRODUCT_BIBLE.md "Havelio Time Model"; always formatted in the
  /// tenant's own timezone for display, never the capturing device's.
  capturedAt        DateTime               @default(now())
  /// The staff member who captured this signature (present for both
  /// TENANT_REPRESENTATIVE signatures and staff-facilitated in-person
  /// CUSTOMER signatures); null for a customer's own portal-drawn
  /// signature. Plain scalar, no relation declared — mirrors
  /// DocumentStatusHistory.changedByUserId's existing convention for a
  /// less-central actor reference.
  capturedByUserId  String?
  /// Set when signerType is CUSTOMER — the customer this signature
  /// belongs to, for portal-side ownership scoping. Plain scalar, no
  /// relation declared (same convention as capturedByUserId above).
  customerId        String?
  createdAt         DateTime               @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("document_signature_evidence")
}

// ---------------------------------------------------------------------
// Customer Portal (TASK-0009) — see docs/adr/0012-customer-portal.md
// ---------------------------------------------------------------------

enum CustomerPortalMessageSender {
  CUSTOMER
  STAFF
}

enum CustomerNotificationType {
  MESSAGE
  DOCUMENT_SHARED
  SIGNATURE_REQUESTED
  EXTENSION_RESPONSE
  RENTAL_UPDATE
  DAMAGE_REPORT_UPDATE
}

enum RentalExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RentalDamageReportStatus {
  SUBMITTED
  REVIEWED
  RESOLVED
  CONVERTED_TO_DOCUMENT
}

/// Rotating refresh tokens for the customer portal session — mirrors
/// RefreshToken exactly (opaque random value, only its SHA-256 hash
/// persisted, see customer-invitation-token.util.ts/customer-token.service.ts)
/// but keyed to Customer, not User, and always tenant-scoped (a customer's
/// portal access is inherently single-tenant, unlike a staff User who may
/// belong to several). Kept as a fully separate table — never a nullable
/// customerId column bolted onto RefreshToken — so a customer session can
/// never be confused with, or accidentally satisfy, a staff auth check.
model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  tenantId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_refresh_tokens")
}

/// A threaded message between a customer and tenant staff, optionally
/// scoped to a specific Rental (a general question has rentalId = null).
/// senderUserId is set only when senderType = STAFF — both nullable so one
/// table serves both directions without a discriminated pair of tables.
model CustomerPortalMessage {
  id               String                      @id @default(uuid())
  tenantId         String
  customerId       String
  rentalId         String?
  senderType       CustomerPortalMessageSender
  senderUserId     String?
  body             String
  createdAt        DateTime                    @default(now())
  readByCustomerAt DateTime?
  readByStaffAt    DateTime?

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rental     Rental?  @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  senderUser User?    @relation("CustomerPortalMessageSentBy", fields: [senderUserId], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, rentalId])
  @@map("customer_portal_messages")
}

/// In-app-only notification — no email/push delivery pipeline exists yet.
/// A deliberate, documented scope boundary (see docs/adr/0012-customer-portal.md),
/// the same "logging placeholder now, real provider later" shape already
/// used for EmailProvider (ADR 0007). Created by whichever portal service
/// performs the triggering action (a new message, a shared document, a
/// signature request, an extension-request response, ...).
model CustomerNotification {
  id         String                   @id @default(uuid())
  tenantId   String
  customerId String
  type       CustomerNotificationType
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime                 @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, customerId, readAt])
  @@map("customer_notifications")
}

/// A customer-submitted request to extend a Rental's plannedEnd. Approving
/// a request does not itself change the Rental — PortalExtensionRequestsService
/// calls the existing RentalsService.update() to perform the actual change,
/// so availability/pricing revalidation logic is never duplicated.
model RentalExtensionRequest {
  id                String                       @id @default(uuid())
  tenantId          String
  rentalId          String
  customerId        String
  currentEnd        DateTime
  requestedEnd      DateTime
  message           String?
  status            RentalExtensionRequestStatus @default(PENDING)
  responseMessage   String?
  createdAt         DateTime                     @default(now())
  respondedAt       DateTime?
  respondedByUserId String?

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental          Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  respondedByUser User?    @relation("RentalExtensionRequestRespondedBy", fields: [respondedByUserId], references: [id])

  @@index([tenantId, rentalId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("rental_extension_requests")
}

/// A customer-submitted damage report — deliberately its own lightweight
/// model, not a Document row: Document.createdByUserId is a required FK to
/// User (every existing Document is staff-authored today), and widening
/// that to accept a customer actor would touch a completed module's core
/// schema far beyond this task's blast radius (see
/// docs/adr/0012-customer-portal.md). A report can later be formalized by
/// staff into a real DAMAGE_REPORT Document via DocumentsService.create
/// (staff as the author of record, using the report's own data as the
/// starting businessData) — convertedDocumentId records that link once it
/// happens.
model RentalDamageReport {
  id                  String                   @id @default(uuid())
  tenantId            String
  rentalId            String
  customerId          String
  assetId             String?
  description         String
  status              RentalDamageReportStatus @default(SUBMITTED)
  convertedDocumentId String?                  @unique
  createdAt           DateTime                 @default(now())
  reviewedAt          DateTime?
  reviewedByUserId    String?

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental            Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset             Asset?    @relation(fields: [assetId], references: [id])
  convertedDocument Document? @relation(fields: [convertedDocumentId], references: [id])
  reviewedByUser    User?     @relation("RentalDamageReportReviewedBy", fields: [reviewedByUserId], references: [id])

  photos RentalDamageReportPhoto[]

  @@index([tenantId, rentalId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("rental_damage_reports")
}

/// A photo attached to a RentalDamageReport, reusing the same
/// storageKey/mimeType/sizeBytes shape as AssetImage/DocumentFile and
/// StorageService directly, rather than routing through DocumentFile,
/// since the parent report is not itself a Document.
model RentalDamageReportPhoto {
  id               String   @id @default(uuid())
  tenantId         String
  damageReportId   String
  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  damageReport RentalDamageReport @relation(fields: [damageReportId], references: [id], onDelete: Cascade)

  @@index([tenantId, damageReportId])
  @@map("rental_damage_report_photos")
}

// ===========================================================================
// Stage 17 — Havelio Monetization & Billing V1.
//
// THREE separate financial domains exist in this codebase. Never mix their
// tables, ledgers, terminology, or reports:
//
//   A) RENTAL FINANCE — money a Havelio TENANT receives from ITS OWN rental
//      customers. Invoice/Payment/RentalDeposit/PaymentDemand above (Stage
//      16). Unchanged by this section.
//   B) HAVELIO BILLING — money HAVELIO receives from tenant companies for
//      using Havelio. HavelioSubscription/StripeWebhookEvent/PromoCode below.
//   C) AFFILIATE COMMISSIONS — money Havelio may owe a partner who referred
//      a paying Havelio customer. AffiliatePartner/AffiliateCampaign/
//      AffiliateAttribution/AffiliateCommissionEntry/AffiliatePayout below.
//
// Platform-admin surfaces over (B)/(C) are gated by User.isPlatformAdmin —
// a distinct, explicit flag, never a tenant MembershipRole and never an
// email allowlist (see PlatformAdminGuard).
// ===========================================================================

enum HavelioPlan {
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// Mirrors the subset of Stripe subscription lifecycle states this product
/// actually models, plus TRIALING/EXPIRED for the card-less trial (which
/// Stripe never sees at all — see HavelioSubscription's own doc comment).
enum HavelioSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
}

/// One row per tenant — the tenant's relationship with HAVELIO's own
/// billing (never the tenant's rental customers' money; see this section's
/// header comment). Created automatically (TRIALING, no Stripe fields) the
/// moment a tenant registers — see TenantsService.register /
/// SubscriptionsService.startTrial. Stripe/webhook state is the ONLY thing
/// that ever moves a row to ACTIVE/PAST_DUE — never the browser returning
/// to a success URL (see docs/DECISIONS.md, StripeWebhooksController).
model HavelioSubscription {
  id       String @id @default(uuid())
  tenantId String @unique

  plan            HavelioPlan
  billingInterval BillingInterval?
  status          HavelioSubscriptionStatus

  /// Safely stored Stripe identifiers — never a secret, always safe to read
  /// back to an OWNER/ADMIN's own Billing page.
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  trialStartedAt     DateTime?
  /// Server-computed at trial start (`trialStartedAt + 14 days`) — never
  /// derived from or trusted from the browser clock. See
  /// SubscriptionsService.isTrialExpired.
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  /// A pending DOWNGRADE, scheduled to take effect at `currentPeriodEnd`
  /// (see docs/DECISIONS.md "Upgrade/downgrade" V1 policy: upgrades apply
  /// immediately with provider-calculated proration; downgrades never take
  /// effect immediately, so a tenant already using more than the lower
  /// plan's limits is never suddenly locked out). Applied lazily — the same
  /// pattern as trial expiry — by SubscriptionsService.getSubscription the
  /// first time it's read after `currentPeriodEnd` has passed (this
  /// codebase has no job scheduler; see docs/DECISIONS.md). Both null when
  /// no downgrade is scheduled.
  scheduledPlan            HavelioPlan?
  scheduledBillingInterval BillingInterval?

  /// True only for the one-time Stage-17 migration row created for a
  /// tenant that already existed before Havelio billing existed (see
  /// docs/DECISIONS.md "existing tenant migration strategy") — an
  /// internal/development entitlement, never reachable via any ordinary
  /// signup/checkout path, and never checked by any code path as a
  /// security bypass (PlatformAdminGuard/entitlement checks do not treat
  /// this specially — it behaves exactly like a real ACTIVE PROFESSIONAL
  /// subscription with no expiry, nothing more).
  isGrandfathered Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([stripeCustomerId])
  @@map("havelio_subscriptions")
}

/// Idempotency guard for Stripe webhook delivery (Stripe's own "at least
/// once" guarantee means every handler must tolerate redelivery) — the
/// primary key is the real Stripe event id (`evt_...`) itself; a second
/// delivery of the same event is a duplicate-key insert the webhook
/// handler treats as "already processed, return 200, do nothing more."
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Mirrors the three Stripe Coupon duration semantics this product
/// supports — never a duration Stripe itself doesn't offer. See
/// docs/DECISIONS.md for exactly how each maps to a Stripe Coupon.
enum PromoDuration {
  ONCE
  REPEATING
  FOREVER
}

/// A discount code redeemable at Havelio checkout — Stripe (Coupon +
/// Promotion Code) is the system of record for the actual discount
/// mechanics whenever `stripeCouponId`/`stripePromotionCodeId` are set;
/// this row is Havelio's own local metadata for validation, eligibility,
/// and attribution reporting (see docs/DECISIONS.md — "Havelio must still
/// store enough local metadata for attribution/reporting"). A code MAY be
/// tied to an AffiliateCampaign (an influencer's code) or stand alone (a
/// plain marketing code like WELCOME20).
model PromoCode {
  id   String @id @default(uuid())
  /// Always stored upper-cased — see promo-codes.service.ts's own
  /// normalization, so lookup is never case-sensitive by accident.
  code String @unique

  discountType       PromoDiscountType
  /// Integer basis points for PERCENTAGE (2000 = 20%); null for FIXED_AMOUNT.
  discountValueBp    Int?
  /// Integer minor units for FIXED_AMOUNT (never a float); null for PERCENTAGE.
  discountValueMinor Int?
  /// Only meaningful for FIXED_AMOUNT — a fixed-amount discount is
  /// currency-specific by nature.
  currency           String?           @db.VarChar(3)

  duration         PromoDuration
  /// Only meaningful for REPEATING (Stripe's `duration_in_months`).
  durationInMonths Int?

  isActive              Boolean   @default(true)
  validFrom             DateTime?
  validUntil            DateTime?
  maxRedemptions        Int?
  redemptionCount       Int       @default(0)
  /// "New customer" restriction — true is the safe default; a promo code
  /// is opt-in to being reusable by an already-attributed tenant.
  firstTimeCustomerOnly Boolean   @default(true)

  /// Empty array (default) means "eligible for every plan".
  eligiblePlans    HavelioPlan[]
  /// Null means "eligible for both monthly and annual".
  eligibleInterval BillingInterval?

  /// Present once this code has a real Stripe Coupon/Promotion Code
  /// provisioned (see docs/DECISIONS.md "do not implement unsupported
  /// Stripe semantics by pretending they exist") — null when Stripe isn't
  /// configured in this environment, or the code hasn't been provisioned
  /// yet.
  stripeCouponId        String?
  stripePromotionCodeId String?

  affiliateCampaignId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliateCampaign AffiliateCampaign?     @relation(fields: [affiliateCampaignId], references: [id])
  attributions      AffiliateAttribution[]

  @@index([affiliateCampaignId])
  @@map("promo_codes")
}

enum AffiliateStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// Havelio PLATFORM-level partner (blogger/influencer/consultant/agency/
/// referral-partner/future-reseller) — belongs to Havelio's own business
/// administration, never a tenant's rental-business settings (see this
/// section's header comment). Visible only through platform-admin
/// surfaces, gated by User.isPlatformAdmin.
model AffiliatePartner {
  id            String          @id @default(uuid())
  displayName   String
  legalName     String?
  email         String
  contactInfo   String?
  status        AffiliateStatus @default(ACTIVE)
  internalNotes String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByUser User @relation("AffiliatePartnerCreatedBy", fields: [createdByUserId], references: [id])

  campaigns         AffiliateCampaign[]
  attributions      AffiliateAttribution[]
  commissionEntries AffiliateCommissionEntry[]
  payouts           AffiliatePayout[]

  @@map("affiliate_partners")
}

/// A partner may run several campaigns over time (e.g. "YouTube September
/// 2026"), each with its own commission rate/duration and its own promo
/// code(s) — the human-readable code itself is never the relational key
/// (see docs/DECISIONS.md); PromoCode.affiliateCampaignId is.
model AffiliateCampaign {
  id     String          @id @default(uuid())
  name   String
  status AffiliateStatus @default(ACTIVE)

  /// The referral-link identifier — `havelio.net/signup?ref=<slug>` (see
  /// docs/DECISIONS.md "referral links" — a query-param is sufficient for
  /// V1, no short-link infrastructure). Unique across every campaign of
  /// every partner. Distinct from PromoCode.code: a visitor following a
  /// referral link is attributed to this campaign even if they never type
  /// a discount code at all.
  slug String @unique

  partnerId String

  /// Integer basis points (2500 = 25%) — V1 only supports PERCENTAGE
  /// commission (see docs/DECISIONS.md "do not overbuild unless easy").
  commissionRateBp         Int
  /// How many months after a tenant's first paid conversion this
  /// campaign's referrals keep earning commission (e.g. 12).
  commissionDurationMonths Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  promoCodes        PromoCode[]
  attributions      AffiliateAttribution[]
  commissionEntries AffiliateCommissionEntry[]

  @@index([partnerId])
  @@map("affiliate_campaigns")
}

/// Which affiliate a tenant is attributed to, if any — always the FIRST
/// valid attribution (see docs/DECISIONS.md "do not silently replace it
/// later"); the unique `tenantId` enforces this at the database level, not
/// just in application code. An ADMIN-sourced row is the one explicit,
/// audited override path (createdByUserId records who).
model AffiliateAttribution {
  id String @id @default(uuid())

  tenantId String @unique

  partnerId   String
  campaignId  String?
  promoCodeId String?

  source       AttributionSource
  attributedAt DateTime          @default(now())

  /// Set only when source=ADMIN.
  createdByUserId String?

  createdAt DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner       AffiliatePartner   @relation(fields: [partnerId], references: [id])
  campaign      AffiliateCampaign? @relation(fields: [campaignId], references: [id])
  promoCode     PromoCode?         @relation(fields: [promoCodeId], references: [id])
  createdByUser User?              @relation("AffiliateAttributionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([partnerId])
  @@index([campaignId])
  @@map("affiliate_attributions")
}

enum AttributionSource {
  PROMO_CODE
  REFERRAL_LINK
  ADMIN
}

enum CommissionEventType {
  COMMISSION_EARNED
  COMMISSION_REVERSED
  MANUAL_ADJUSTMENT
  PAYOUT
}

/// The auditable affiliate commission ledger (see docs/DECISIONS.md "do
/// not silently rewrite history" — mirrors Payment's void-never-mutate
/// convention exactly, one append-only row per financial event). A
/// partner's current payable balance is always the live sum of this
/// table's `amountMinor`, never a separately stored running total. The
/// `@@unique([stripeInvoiceId, eventType])` below is the actual database-
/// level idempotency guarantee behind "duplicate webhook cannot create
/// duplicate commission" — not just application-code care.
model AffiliateCommissionEntry {
  id         String  @id @default(uuid())
  partnerId  String
  /// Null only for a PAYOUT/MANUAL_ADJUSTMENT row that isn't tied to one
  /// specific tenant (a manual payout is partner-level — see
  /// AffiliatePayoutsService). Always set for COMMISSION_EARNED/
  /// COMMISSION_REVERSED.
  tenantId   String?
  campaignId String?

  eventType CommissionEventType

  /// The Stripe invoice this entry was computed from — null for
  /// MANUAL_ADJUSTMENT/PAYOUT rows not tied to one specific invoice.
  stripeInvoiceId String?

  currency             String @db.VarChar(3)
  /// The real collected revenue (Stripe invoice `amount_paid`, never the
  /// nominal plan price) this commission was computed against — 0 for
  /// MANUAL_ADJUSTMENT/PAYOUT rows.
  eligibleRevenueMinor Int    @default(0)
  /// Integer basis points AT THE TIME this entry was created — never
  /// re-derived from the campaign's current rate later, so history stays
  /// reconstructable even after a campaign's rate is edited.
  commissionRateBp     Int    @default(0)
  /// This entry's own signed effect on the partner's payable balance:
  /// positive for COMMISSION_EARNED/a positive MANUAL_ADJUSTMENT, negative
  /// for COMMISSION_REVERSED/PAYOUT/a negative MANUAL_ADJUSTMENT.
  amountMinor          Int

  /// Set only on a COMMISSION_REVERSED row — the original COMMISSION_EARNED
  /// entry being reversed. The original row is NEVER edited or deleted.
  reversesEntryId String?
  /// Set only on a PAYOUT row — links to the richer AffiliatePayout record
  /// (method/reference/note/recordedBy).
  payoutId        String? @unique

  note String?

  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  partner       AffiliatePartner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tenant        Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign      AffiliateCampaign?         @relation(fields: [campaignId], references: [id])
  reversesEntry AffiliateCommissionEntry?  @relation("CommissionReversal", fields: [reversesEntryId], references: [id])
  reversedBy    AffiliateCommissionEntry[] @relation("CommissionReversal")
  payout        AffiliatePayout?           @relation(fields: [payoutId], references: [id])

  @@unique([stripeInvoiceId, eventType])
  @@index([partnerId, earnedAt])
  @@index([tenantId])
  @@map("affiliate_commission_entries")
}

enum AffiliatePayoutMethod {
  BANK_TRANSFER
  PAYPAL
  OTHER
}

/// Stage 17 V1 payouts are always a MANUAL record of money the platform
/// admin already sent the partner OUTSIDE Havelio (see docs/DECISIONS.md
/// "never pretend Havelio transferred money") — no Stripe Connect, no
/// automated transfer. Recording one here creates exactly one
/// AffiliateCommissionEntry(eventType=PAYOUT, amountMinor negative) so the
/// partner's payable balance drops by the recorded amount.
model AffiliatePayout {
  id        String @id @default(uuid())
  partnerId String

  amountMinor Int
  currency    String                @db.VarChar(3)
  payoutDate  DateTime
  method      AffiliatePayoutMethod
  reference   String?
  note        String?

  recordedByUserId String
  createdAt        DateTime @default(now())

  partner        AffiliatePartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  recordedByUser User                      @relation("AffiliatePayoutRecordedBy", fields: [recordedByUserId], references: [id])
  ledgerEntry    AffiliateCommissionEntry?

  @@index([partnerId, payoutDate])
  @@map("affiliate_payouts")
}

/// Stage 18 hook, per this task's explicit "prepare, do not write" scope —
/// no legal pages/UI exist yet, but signup/checkout acceptance can already
/// record which terms/privacy-policy VERSION a tenant accepted, when, and
/// through which flow, so Stage 18 has real data to build on rather than a
/// backfill problem. `termsVersion`/`source` are free-text (no fixed
/// version registry exists yet — Stage 18's job) rather than a fabricated
/// enum pretending final versions already exist.
model LegalAcceptanceRecord {
  id       String  @id @default(uuid())
  tenantId String?

  termsVersion   String
  privacyVersion String?

  acceptedByUserId String?
  acceptedAt       DateTime @default(now())
  /// e.g. "SIGNUP", "CHECKOUT" — free text, see model doc comment.
  source           String

  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptedByUser User?   @relation("LegalAcceptanceAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([tenantId])
  @@map("legal_acceptance_records")
}
