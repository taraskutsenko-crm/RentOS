# Node
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=rentos
POSTGRES_PASSWORD=rentos
POSTGRES_DB=rentos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rentos:rentos@localhost:5432/rentos?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
PORT=4000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth
# Origin allowed to call the API with credentials (CORS). Must match the
# web app's origin exactly.
WEB_ORIGIN=http://localhost:3000
# Secret used to sign short-lived JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Never reuse this value across environments.
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# Separate secret for customer-portal sessions (TASK-0009) — never reuse
# JWT_ACCESS_SECRET here; the two token types must stay cryptographically
# unrelated. Generate the same way as JWT_ACCESS_SECRET above.
JWT_CUSTOMER_ACCESS_SECRET=dev-only-change-me-portal-dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Leave unset for localhost development. In production, set to the parent
# domain shared by the web and api subdomains (e.g. ".rentos.com") so the
# auth cookies are sent to both.
# COOKIE_DOMAIN=

# File storage (asset images/documents). The local-filesystem adapter is
# used everywhere today; see docs/adr/0007-asset-file-storage-strategy.md
# for the S3-compatible interface it implements and how to swap in a real
# S3/R2/MinIO adapter in production.
STORAGE_LOCAL_DIR=./storage-uploads
