# Used when running the API directly with `pnpm --filter @rentos/api dev`
# (outside Docker Compose, against a locally reachable PostgreSQL/Redis).

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://rentos:rentos@localhost:5432/rentos?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_LOCAL_DIR=./storage-uploads
# AES-256-GCM key encrypting e-invoice provider credentials (e.g. KSeF) at
# rest — 64 hex characters (32 bytes). Generate a real one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KSEF_ENCRYPTION_KEY=467bc28bf643d5e05d8f7bb4b03b2e531be5659d65c009d64b7ef188828393e4
