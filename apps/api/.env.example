# Used when running the API directly with `pnpm --filter @rentos/api dev`
# (outside Docker Compose, against a locally reachable PostgreSQL/Redis).

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://rentos:rentos@localhost:5432/rentos?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_LOCAL_DIR=./storage-uploads
